{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/_content/*",
      "/css/*",
      "/*.{js,json,css,wasm,webmanifest,png,jpg,jpeg,gif,svg,ico,woff,woff2,br,gz}"
    ]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
