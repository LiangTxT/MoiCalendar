<section class="mini-calendar" aria-label="迷你月历">
    <header>
        <strong>@displayedMonth.Year 年 @displayedMonth.Month 月</strong>
        <span>
            <button class="mini-calendar-button" type="button" aria-label="迷你月历上一个月" @onclick="ShowPreviousMonth">‹</button>
            <button class="mini-calendar-button" type="button" aria-label="迷你月历下一个月" @onclick="ShowNextMonth">›</button>
        </span>
    </header>
    <div class="mini-weekdays" aria-hidden="true">
        @foreach (var label in WeekdayLabels)
        {
            <span>@label</span>
        }
    </div>
    <div class="mini-month-grid">
        @foreach (var date in displayedView.Dates)
        {
            <button type="button"
                    class="@GetDateClass(date)"
                    aria-label="@date.Date.ToString("yyyy-MM-dd")"
                    aria-current="@(date.IsToday ? "date" : null)"
                    @onclick="() => SelectDate.InvokeAsync(date.Date)">@date.DayNumber</button>
        }
    </div>
</section>

@code {
    private static readonly string[] WeekdayLabels = ["一", "二", "三", "四", "五", "六", "日"];
    private CalendarMonth displayedMonth;
    private CalendarMonthView displayedView = null!;
    private CalendarMonth lastMainMonth;

    [Parameter] public CalendarMonth MainMonth { get; set; }
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public EventCallback<DateOnly> SelectDate { get; set; }

    protected override void OnParametersSet()
    {
        if (displayedView is null || MainMonth != lastMainMonth)
        {
            displayedMonth = MainMonth;
            lastMainMonth = MainMonth;
        }

        displayedView = displayedMonth.CreateView(Today);
    }

    private void ShowPreviousMonth()
    {
        displayedMonth = displayedMonth.Previous();
        displayedView = displayedMonth.CreateView(Today);
    }

    private void ShowNextMonth()
    {
        displayedMonth = displayedMonth.Next();
        displayedView = displayedMonth.CreateView(Today);
    }

    private string GetDateClass(CalendarDateCell date)
    {
        var classes = "mini-date";
        if (!date.IsInActiveMonth) classes += " outside-month";
        if (date.IsToday) classes += " today";
        if (date.Date == SelectedDate) classes += " selected";
        return classes;
    }
}
