<header class="calendar-toolbar @(DisplayMode == CalendarViewMode.Month ? "month-mode" : null)">
    <div class="toolbar-leading">
        <button class="icon-button" type="button" aria-label="切换日历侧栏" aria-expanded="@SidebarOpen" @onclick="ToggleSidebar">
            <span class="nav-toggle-glyph" aria-hidden="true"><i></i><i></i></span>
        </button>
        <span class="command-brand"><b>MOI</b><span>/ CAL</span></span>
    </div>

    <nav class="toolbar-period" aria-label="日期范围导航">
        <button class="icon-button" type="button" aria-label="@PreviousAriaLabel" @onclick="ShowPrevious">
            <span aria-hidden="true">‹</span>
        </button>
        <button class="toolbar-today" type="button" @onclick="ShowToday">今天</button>
        <button class="icon-button" type="button" aria-label="@NextAriaLabel" @onclick="ShowNext">
            <span aria-hidden="true">›</span>
        </button>
        @if (DisplayMode == CalendarViewMode.Month)
        {
            <strong class="command-period-title month-period-title" aria-live="polite">
                <span class="period-number">@MonthYear</span><span class="period-unit">年</span>
                <span class="period-number">@MonthNumber</span><span class="period-unit">月</span>
            </strong>
        }
        else
        {
            <strong class="command-period-title" aria-live="polite" aria-label="@PeriodTitle" title="@PeriodTitle">
                <span class="period-title-full" aria-hidden="true">@PeriodTitle</span>
                <span class="period-title-compact" aria-hidden="true">@(CompactPeriodTitle ?? PeriodTitle)</span>
            </strong>
        }
    </nav>

    <div class="toolbar-actions">
        <nav class="view-switcher" aria-label="日历视图">
            @foreach (var option in ViewOptions)
            {
                <button type="button"
                        class="@(DisplayMode == option.Mode ? "active" : null)"
                        aria-pressed="@(DisplayMode == option.Mode ? "true" : "false")"
                        @onclick="() => ViewChanged.InvokeAsync(option.Mode)">@option.Label</button>
            }
        </nav>
        <button class="header-search" type="button" aria-label="搜索日历" @onclick="SearchRequested">
            <span aria-hidden="true">⌕</span><span>搜索</span><kbd>Ctrl K</kbd>
        </button>
        <button class="add-event-button" type="button" aria-label="新建事件" @onclick="CreateEvent">
            <span aria-hidden="true">＋</span><span class="add-event-label">新建</span>
        </button>
    </div>
</header>

@code {
    private static readonly (CalendarViewMode Mode, string Label)[] ViewOptions =
    [
        (CalendarViewMode.Month, "月"),
        (CalendarViewMode.Week, "周"),
        (CalendarViewMode.Day, "日"),
        (CalendarViewMode.Agenda, "日程")
    ];

    [Parameter] public bool SidebarOpen { get; set; }
    [Parameter, EditorRequired] public string PeriodTitle { get; set; } = string.Empty;
    [Parameter] public string? CompactPeriodTitle { get; set; }
    [Parameter] public int MonthYear { get; set; }
    [Parameter] public int MonthNumber { get; set; }
    [Parameter, EditorRequired] public string PreviousAriaLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NextAriaLabel { get; set; } = string.Empty;
    [Parameter] public CalendarViewMode DisplayMode { get; set; }
    [Parameter] public EventCallback ToggleSidebar { get; set; }
    [Parameter] public EventCallback ShowToday { get; set; }
    [Parameter] public EventCallback ShowPrevious { get; set; }
    [Parameter] public EventCallback ShowNext { get; set; }
    [Parameter] public EventCallback CreateEvent { get; set; }
    [Parameter] public EventCallback SearchRequested { get; set; }
    [Parameter] public EventCallback<CalendarViewMode> ViewChanged { get; set; }
}
