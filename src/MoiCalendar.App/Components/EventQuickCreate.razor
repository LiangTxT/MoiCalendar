<section class="quick-create-popover app-scrollable scrollbar-subtle"
             role="dialog"
             aria-modal="true"
             aria-labelledby="quick-create-title"
             @onclick:stopPropagation="true">
        <header>
            <h2 id="quick-create-title">新建事件</h2>
            <button class="icon-button" type="button" aria-label="关闭快速创建" @onclick="Close">×</button>
        </header>

        <form @onsubmit="Create" @onsubmit:preventDefault="true">
            <label class="visually-hidden" for="quick-event-title">标题</label>
            <input id="quick-event-title"
                   @ref="titleInput"
                   class="quick-create-title"
                   type="text"
                   maxlength="200"
                   required
                   autofocus
                   placeholder="添加标题"
                   @bind="Draft.Title"
                   @bind:event="oninput" />

            <div class="quick-create-field">
                <label for="quick-event-calendar">日历</label>
                <select id="quick-event-calendar">
                    <option>本地日历</option>
                </select>
            </div>

            <div class="quick-create-field">
                <label for="quick-event-date">日期</label>
                <TemporalInput Id="quick-event-date" @bind-Value="DateInput" HintId="quick-date-time-hint" Required="true" />
            </div>

            <EventColorPicker @bind-Value="Draft.ColorIndex" Disabled="IsSaving" />
            <EventReminderPicker Draft="Draft" Id="quick-event-reminder" />

            <div class="quick-create-field quick-create-all-day">
                <span>全天</span>
                <label class="toggle-control" for="quick-event-all-day">
                    <input id="quick-event-all-day"
                           type="checkbox"
                           checked="@Draft.IsAllDay"
                           @onchange="ChangeAllDay" />
                    <span aria-hidden="true"></span>
                    <span class="visually-hidden">全天事件</span>
                </label>
            </div>

            @if (Draft.IsAllDay)
            {
                <div class="quick-create-field">
                    <label for="quick-event-end-date">结束日期<br /><span class="field-hint">包含当天</span></label>
                    <TemporalInput Id="quick-event-end-date" @bind-Value="EndDateInput" Min="@DateInput" HintId="quick-date-time-hint" Required="true" />
                </div>
            }
            else
            {
                <div class="quick-create-time-pair">
                    <div>
                    <label for="quick-event-start">开始</label>
                    <TemporalInput Id="quick-event-start" Type="time" @bind-Value="StartTimeInput" HintId="quick-date-time-hint" Required="true" />
                    </div>
                    <div>
                    <label for="quick-event-end">结束</label>
                    <TemporalInput Id="quick-event-end" Type="time" @bind-Value="EndTimeInput" HintId="quick-date-time-hint" Required="true" />
                    </div>
                </div>
                @if (schedule.CrossesMidnight)
                {
                    <div class="quick-create-field">
                        <label for="quick-event-end-date">结束日期</label>
                        <TemporalInput Id="quick-event-end-date" @bind-Value="EndDateInput" Min="@DateInput" HintId="quick-date-time-hint" Required="true" />
                    </div>
                }
            }

            <p id="quick-date-time-hint" class="date-time-input-hint">单击选择日期或时间，双击直接输入</p>
            <p class="quick-create-summary" aria-live="polite">@schedule.Summary</p>

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="editor-error" role="alert">@Error</p>
            }

            <footer>
                <button type="button" disabled="@IsSaving" @onclick="MoreDetails">更多详情</button>
                <span class="action-spacer"></span>
                <button class="primary-button" type="submit" disabled="@IsSaving">
                    @(IsSaving ? "正在创建…" : "创建")
                </button>
            </footer>
        </form>
    </section>

@code {
    private ElementReference titleInput;
    private QuickCreateSchedule schedule = null!;
    private CalendarEventDraft? boundDraft;

    [Parameter, EditorRequired]
    public CalendarEventDraft Draft { get; set; } = null!;

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public EventCallback Create { get; set; }

    [Parameter]
    public EventCallback MoreDetails { get; set; }

    [Parameter]
    public EventCallback Close { get; set; }

    private string DateInput { get => schedule.DateInput; set => schedule.DateInput = value; }
    private string EndDateInput { get => schedule.EndDateInput; set => schedule.EndDateInput = value; }
    private string StartTimeInput { get => schedule.StartTimeInput; set => schedule.StartTimeInput = value; }
    private string EndTimeInput { get => schedule.EndTimeInput; set => schedule.EndTimeInput = value; }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(boundDraft, Draft))
        {
            boundDraft = Draft;
            schedule = new QuickCreateSchedule(Draft);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await titleInput.FocusAsync();
        }
    }

    private void ChangeAllDay(ChangeEventArgs args)
    {
        if (args.Value is bool isAllDay)
        {
            schedule.SetAllDay(isAllDay);
        }
    }

}
