@implements IAsyncDisposable
@inject CalendarEventService Events
@inject IJSRuntime JS

<section class="agenda agenda-stream app-scrollable" aria-label="日程列表" @ref="stream">
    <div class="agenda-edge" data-agenda-previous role="status" aria-live="polite">
        @(busy ? "正在读取月份…" : "向上滚动查看更早月份")
    </div>
    @if (error is not null)
    {
        <p class="storage-error" role="alert">@error</p>
        <button class="agenda-load" type="button" disabled="@busy" @onclick="RetryAsync">重试读取月份</button>
    }
    @foreach (var entry in months)
    {
        var month = entry.Month;
        <AgendaMonthSection @key="month" Month="month" View="entry.View" Today="Today" CalendarVisible="CalendarVisible"
                            EventSelected="EventSelected" EventEdit="EventEdit" OpenDay="OpenDay" CreateEvent="CreateEvent" />
    }
    <button class="agenda-load" type="button" disabled="@busy" @onclick="() => ExtendAsync(1)" data-agenda-next>@(busy ? "正在读取…" : "查看之后的月份")</button>
</section>

@code {
    [Parameter] public CalendarMonth Month { get; set; }
    [Parameter] public int ReloadVersion { get; set; }
    private int loadedReloadVersion = -1;
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = "UTC";
    [Parameter] public bool CalendarVisible { get; set; } = true;
    [Parameter] public EventCallback<CalendarOccurrenceReference> EventSelected { get; set; }
    [Parameter] public EventCallback<CalendarOccurrenceReference> EventEdit { get; set; }
    [Parameter] public EventCallback<DateOnly> OpenDay { get; set; }
    [Parameter] public EventCallback<DateOnly> CreateEvent { get; set; }
    [Parameter] public EventCallback<CalendarMonth> VisibleMonthChanged { get; set; }
    private readonly List<(CalendarMonth Month, CalendarAgendaView View)> months = [];
    private CalendarMonth? loadedMonth;
    private ElementReference stream;
    private IJSObjectReference? module;
    private DotNetObjectReference<AgendaStream>? reference;
    private bool busy;
    private bool disposed;
    private int loadVersion;
    private int failedDirection = -1;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedMonth == Month && loadedReloadVersion == ReloadVersion) return;
        var refresh = loadedMonth == Month && months.Count > 0;
        var refreshMonths = refresh ? months.Select(item => item.Month).ToArray() : null;
        loadedReloadVersion = ReloadVersion;
        loadedMonth = Month;
        var version = ++loadVersion;
        if (!refresh) months.Clear();
        busy = true;
        try
        {
            // 保留本月在顶部，预读后两个月；向上扩展时不替换已呈现的内容。
            var next = Month;
            var loaded = new List<(CalendarMonth Month, CalendarAgendaView View)>();
            var initialMonths = refreshMonths ?? Enumerable.Range(0, Math.Min(3, (9999 - Month.Year) * 12 + 13 - Month.Month))
                .Select(offset => CalendarMonth.FromDate(new DateOnly(Month.Year, Month.Month, 1).AddMonths(offset))).ToArray();
            var refreshedViews = await Events.GetAgendaViewsAsync(initialMonths, TimeZoneId);
            for (var index = 0; index < initialMonths.Length; index++)
            {
                next = initialMonths[index];
                var view = refreshedViews[next];
                if (disposed || version != loadVersion) return;
                loaded.Add((next, view));
                if (next.Year == 9999 && next.Month == 12) break;
                next = next.Next();
            }
            months.Clear();
            months.AddRange(loaded);
            error = null;
        }
        catch (EventRepositoryException exception) { if (version == loadVersion) error = exception.Message; }
        finally { if (version == loadVersion) busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./agendaStream.js");
            reference ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("connect", stream, reference, error is null && !busy, loadedMonth?.ToString());
        }
        catch (JSException) { /* 无脚本时仍可通过按钮读取相邻月份。 */ }
    }

    [JSInvokable]
    public Task ReportVisibleMonth(int year, int month) => disposed ? Task.CompletedTask : VisibleMonthChanged.InvokeAsync(new CalendarMonth(year, month));

    [JSInvokable]
    public async Task ExtendAsync(int direction)
    {
        if (busy || disposed || months.Count == 0) return;
        var edge = direction < 0 ? months[0].Month : months[^1].Month;
        if (direction < 0 && edge.Year == 1 && edge.Month == 1 || direction >= 0 && edge.Year == 9999 && edge.Month == 12) return;
        busy = true;
        var version = loadVersion;
        try
        {
            // 一次预读三个月，只读取一遍本地数据；呈现内容等原生滚动停稳后再提交。
            var edgeDate = new DateOnly(edge.Year, edge.Month, 1);
            var available = direction < 0 ? (edge.Year - 1) * 12 + edge.Month - 1 : (9999 - edge.Year) * 12 + 12 - edge.Month;
            var requested = Enumerable.Range(1, Math.Min(3, available))
                .Select(offset => CalendarMonth.FromDate(edgeDate.AddMonths(direction < 0 ? -offset : offset)))
                .OrderBy(month => month.Year).ThenBy(month => month.Month).ToArray();
            var views = await Events.GetAgendaViewsAsync(requested, TimeZoneId);
            if (module is not null) await module.InvokeVoidAsync("waitForIdle", stream);
            if (disposed || version != loadVersion) return;
            if (direction < 0)
            {
                if (module is not null) await module.InvokeVoidAsync("rememberPosition", stream);
                months.InsertRange(0, requested.Select(month => (month, views[month])));
            }
            else months.AddRange(requested.Select(month => (month, views[month])));
            error = null;
        }
        catch (EventRepositoryException exception) { if (version == loadVersion) { error = exception.Message; failedDirection = direction; } }
        finally { if (version == loadVersion) busy = false; }
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task RetryAsync()
    {
        if (busy || disposed) return;
        if (months.Count == 0) { loadedMonth = null; await OnParametersSetAsync(); }
        else await ExtendAsync(failedDirection);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("disconnect", stream); await module.DisposeAsync(); }
            catch (JSException) { }
        }
        reference?.Dispose();
    }
}
