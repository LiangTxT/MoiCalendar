@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="week-calendar @(IsDayView ? "day-mode" : null) @(ShowHalfHourLines ? "show-half-hour-lines" : "hide-half-hour-lines") @(gesture?.IsActive == true ? "is-direct-manipulation" : null)"
         aria-label="@AriaLabel"
         style="@GridStyle"
         @ref="interactionSurface"
         @onpointermove="HandlePointerMoveAsync"
         @onpointerup="CommitPointerInteractionAsync"
         @onpointercancel="CancelPointerInteraction">
    @if (!VisibleDays.Any(day => day.AllDayEvents.Count > 0 || day.TimedEvents.Count > 0))
    {
        <p class="week-empty" role="status">@EmptyMessage</p>
    }

    <div class="week-horizontal-scroll">
        <div class="week-grid-frame">
            <TimeGridHeader Days="VisibleDays"
                            SelectedDate="SelectedDate"
                            Today="Today"
                            DateSelected="DateSelected" />

            <AllDayPanel Days="VisibleDays"
                         Today="Today"
                         MaxVisibleRows="MaxVisibleAllDayRows"
                         EventSelected="EventSelected"
                         EventFocused="EventFocused" />

            <div class="week-timed-scroll" @ref="timedScrollElement">
                <div class="week-timed-layout">
                    <div class="week-time-labels" aria-hidden="true">
                        @foreach (var hour in TimeLabelHours)
                        {
                            <span style="@GetTimeLabelStyle(hour)">@($"{hour:D2}:00")</span>
                        }
                    </div>

                    <div class="week-timed-days" @ref="timedDaysElement">
                        @foreach (var day in VisibleDays)
                        {
                            var eventLayouts = GetTimedEventLayouts(day);
                            <div class="week-timed-day @(day.Date.Date == Today ? "today" : null) @(day.Date.Date == SelectedDate ? "selected" : null)"
                                 @onpointerdown="args => BeginSelection(day.Date.Date, args)"
                                 @onclick="args => HandleDateClickAsync(day.Date.Date, args)"
                                 @ondblclick="args => RequestQuickCreateAtPointerAsync(day.Date.Date, args)">
                                <CurrentTimeIndicator Date="day.Date.Date" Metrics="GridMetrics" />

                                @if (preview is { } activePreview && activePreview.TargetDate == day.Date.Date)
                                {
                                    <div class="calendar-interaction-preview @activePreview.Kind.ToString().ToLowerInvariant()"
                                         style="@GetPreviewStyle(activePreview)"
                                         role="status"
                                         aria-live="polite">
                                        <strong>@activePreview.Label</strong>
                                        <span>@FormatPreview(activePreview)</span>
                                    </div>
                                }

                                @foreach (var calendarEvent in day.TimedEvents.Where(item => eventLayouts.ContainsKey(item.Id)))
                                {
                                    <TimedEventBlock CalendarEvent="calendarEvent"
                                                     Layout="eventLayouts[calendarEvent.Id]"
                                                     Date="day.Date.Date"
                                                     ShowExtendedMetadata="IsDayView"
                                                     IsSelected="@(SelectedEventId == calendarEvent.Id)"
                                                     IsInteractionSource="@IsInteracting(calendarEvent.Id)"
                                                     Focused="EventFocused"
                                                     Selected="HandleEventClickAsync"
                                                     Edit="HandleEventDoubleClickAsync"
                                                     PointerDown="HandleTimedEventPointerDown"
                                                     ResizePointerDown="HandleResizePointerDown" />
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int TouchHoldMilliseconds = 350;
    private ElementReference interactionSurface;
    private ElementReference timedScrollElement;
    private ElementReference timedDaysElement;
    private TimeGridMetrics gridMetrics = TimeGridMetrics.FullDay;
    private string? initializedScrollContext;
    private bool scrollInitializationPending = true;
    private PointerGesture? gesture;
    private InteractionPreview? preview;
    private bool suppressNextClick;
    private string lastPointerType = string.Empty;
    private CancellationTokenSource? eventClickCancellation;

    [Parameter, EditorRequired]
    public CalendarWeekEventView WeekEvents { get; set; } = CalendarWeekEventView.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter]
    public DateOnly? VisibleDate { get; set; }

    [Parameter]
    public DateOnly SelectedDate { get; set; }

    [Parameter]
    public Guid? SelectedEventId { get; set; }

    [Parameter, EditorRequired]
    public string InteractionTimeZoneId { get; set; } = TimeZoneInfo.Utc.Id;

    [Parameter]
    public EventCallback<Guid> EventSelected { get; set; }

    [Parameter]
    public EventCallback<Guid> EventFocused { get; set; }

    [Parameter]
    public EventCallback<Guid> EventEditRequested { get; set; }

    [Parameter]
    public EventCallback<DateOnly> DateSelected { get; set; }

    [Parameter]
    public EventCallback<CalendarInteractionIntent> IntentRequested { get; set; }

    [Parameter]
    public int VisibleStartHour { get; set; }

    [Parameter]
    public int VisibleEndHour { get; set; } = 24;

    [Parameter]
    public bool ShowHalfHourLines { get; set; } = true;

    [Parameter]
    public int DefaultScrollHour { get; set; } = 8;

    [Parameter]
    public int MaxVisibleAllDayRows { get; set; } = 3;

    private bool IsDayView => VisibleDate is not null;

    private IReadOnlyList<CalendarWeekDayEvents> VisibleDays =>
        CalendarTimeGridProjection.SelectDays(WeekEvents.Days, VisibleDate);

    private TimeGridMetrics GridMetrics => gridMetrics;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private IReadOnlyList<int> TimeLabelHours => Enumerable
        .Range(VisibleStartHour, VisibleEndHour - VisibleStartHour)
        .ToArray();

    private string ScrollContextKey => IsDayView ? "day" : "week";

    private string GridStyle => FormattableString.Invariant(
        $"--visible-days:{Math.Max(1, VisibleDays.Count)};--time-grid-hours:{GridMetrics.VisibleDurationMinutes / 60d:0.####}");

    private string EmptyMessage => IsDayView
        ? "当天暂无事件，选择时间区域可新建事件。"
        : "本周暂无事件，选择日期可新建事件。";

    protected override void OnParametersSet()
    {
        gridMetrics = new TimeGridMetrics(VisibleStartHour * 60, VisibleEndHour * 60);
        var context = $"{ScrollContextKey}:{VisibleStartHour}-{VisibleEndHour}";
        if (!string.Equals(initializedScrollContext, context, StringComparison.Ordinal))
        {
            initializedScrollContext = context;
            scrollInitializationPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollInitializationPending)
        {
            return;
        }

        scrollInitializationPending = false;
        try
        {
            await JS.InvokeVoidAsync(
                "moicalendarUi.initializeCalendarScroll",
                timedScrollElement,
                ScrollContextKey,
                GetInitialScrollMinute(),
                GridMetrics.VisibleStartMinute,
                GridMetrics.VisibleEndMinute);
        }
        catch (JSException)
        {
            // 初始定位是渐进增强，不影响日历数据和交互。
        }
    }

    public ValueTask DisposeAsync()
    {
        eventClickCancellation?.Cancel();
        eventClickCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }

    private string GetTimeLabelStyle(int hour) =>
        FormattableString.Invariant(
            $"--time-label-top:{TimeGridCoordinateConverter.MinuteToPercentage(hour * 60, GridMetrics):0.####}%;");

    private IReadOnlyDictionary<Guid, TimeGridLayoutItem> GetTimedEventLayouts(CalendarWeekDayEvents day) =>
        CalendarTimeGridProjection.LayoutTimedEvents(day, GridMetrics);

    private int GetInitialScrollMinute()
    {
        var target = VisibleDays.Any(day => day.Date.Date == Today)
            ? (int)DateTime.Now.TimeOfDay.TotalMinutes - 120
            : DefaultScrollHour * 60;
        return Math.Clamp(target, GridMetrics.VisibleStartMinute, GridMetrics.VisibleEndMinute);
    }

    private void BeginTimedMove(
        CalendarWeekTimedEvent calendarEvent,
        DateOnly date,
        PointerEventArgs args)
    {
        if (args.Button != 0 || calendarEvent.SegmentPosition != CalendarEventSegmentPosition.Single)
        {
            return;
        }

        gesture = PointerGesture.ForEvent(
            CalendarPointerGestureKind.Move,
            calendarEvent,
            date,
            args,
            DateTimeOffset.UtcNow);
    }

    private void HandleTimedEventPointerDown(TimedEventPointerArgs interaction)
    {
        if (!interaction.CalendarEvent.IsReadOnly)
        {
            BeginTimedMove(
                interaction.CalendarEvent,
                interaction.Date,
                interaction.PointerEvent);
        }
    }

    private void BeginResize(
        CalendarWeekTimedEvent calendarEvent,
        DateOnly date,
        PointerEventArgs args)
    {
        if (args.Button != 0)
        {
            return;
        }

        gesture = PointerGesture.ForEvent(
            CalendarPointerGestureKind.Resize,
            calendarEvent,
            date,
            args,
            DateTimeOffset.UtcNow);
    }

    private void HandleResizePointerDown(TimedEventPointerArgs interaction)
    {
        if (!interaction.CalendarEvent.IsReadOnly)
        {
            BeginResize(
                interaction.CalendarEvent,
                interaction.Date,
                interaction.PointerEvent);
        }
    }

    private void BeginSelection(DateOnly date, PointerEventArgs args)
    {
        if (args.Button != 0)
        {
            return;
        }

        gesture = PointerGesture.ForSelection(date, args, DateTimeOffset.UtcNow);
        lastPointerType = args.PointerType;
    }

    private async Task HandlePointerMoveAsync(PointerEventArgs args)
    {
        if (gesture is not { } current || current.PointerId != args.PointerId)
        {
            return;
        }

        if (!current.IsActive)
        {
            if (!CalendarInteractionGeometry.HasExceededMovementThreshold(
                    current.StartX,
                    current.StartY,
                    args.ClientX,
                    args.ClientY) ||
                IsTouchWaiting(current))
            {
                return;
            }

            current = current with { IsActive = true };
            gesture = current;
            try
            {
                await JS.InvokeVoidAsync("moicalendarInteraction.capturePointer", interactionSurface, args.PointerId);
            }
            catch (JSException)
            {
                // 指针捕获失败时仍允许在网格范围内完成交互。
            }
        }

        ElementBounds bounds;
        try
        {
            bounds = await JS.InvokeAsync<ElementBounds>("moicalendarInteraction.getElementBounds", timedDaysElement);
        }
        catch (JSException)
        {
            CancelPointerInteraction();
            return;
        }

        var dayIndex = CalendarInteractionGeometry.DateIndexFromPointer(
            args.ClientX,
            bounds.Left,
            bounds.Width,
            VisibleDays.Count);
        var targetDate = VisibleDays[dayIndex].Date.Date;
        var pointerMinute = CalendarInteractionGeometry.MinuteFromPointer(
            args.ClientY,
            bounds.Top,
            bounds.Height,
            metrics: GridMetrics);
        preview = CreatePreview(current, targetDate, pointerMinute, bounds, args.ClientY);
    }

    private async Task CommitPointerInteractionAsync(PointerEventArgs args)
    {
        if (gesture is not { IsActive: true } current ||
            current.PointerId != args.PointerId ||
            preview is not { } committedPreview)
        {
            gesture = null;
            preview = null;
            return;
        }

        suppressNextClick = true;
        gesture = null;
        preview = null;
        try
        {
            await JS.InvokeVoidAsync("moicalendarInteraction.releasePointer", interactionSurface, args.PointerId);
        }
        catch (JSException)
        {
            // 浏览器也会在 pointerup 后自动释放捕获。
        }

        var intent = BuildIntent(current, committedPreview);
        if (IntentRequested.HasDelegate)
        {
            await IntentRequested.InvokeAsync(intent);
        }
    }

    private void CancelPointerInteraction()
    {
        gesture = null;
        preview = null;
    }

    private InteractionPreview CreatePreview(
        PointerGesture current,
        DateOnly targetDate,
        int pointerMinute,
        ElementBounds bounds,
        double currentY)
    {
        if (current.Kind == CalendarPointerGestureKind.Selection)
        {
            var startMinute = CalendarInteractionGeometry.MinuteFromPointer(
                current.StartY,
                bounds.Top,
                bounds.Height,
                metrics: GridMetrics);
            var first = Math.Min(startMinute, pointerMinute);
            var last = Math.Max(startMinute, pointerMinute);
            if (last - first < CalendarInteractionGeometry.MinimumTimedDurationMinutes)
            {
                last = Math.Min(
                    GridMetrics.VisibleEndMinute,
                    first + CalendarInteractionGeometry.MinimumTimedDurationMinutes);
            }

            return new InteractionPreview(current.Kind, targetDate, first, last, "新事件");
        }

        var calendarEvent = current.CalendarEvent!;
        if (current.Kind == CalendarPointerGestureKind.Resize)
        {
            var endMinute = Math.Max(
                calendarEvent.StartMinute + CalendarInteractionGeometry.MinimumTimedDurationMinutes,
                pointerMinute);
            return new InteractionPreview(
                current.Kind,
                current.OriginalDate,
                calendarEvent.StartMinute,
                Math.Min(GridMetrics.VisibleEndMinute, endMinute),
                calendarEvent.Title);
        }

        var duration = calendarEvent.DurationMinutes;
        var start = Math.Min(
            pointerMinute,
            GridMetrics.VisibleEndMinute - Math.Min(duration, GridMetrics.VisibleDurationMinutes));
        start = Math.Max(GridMetrics.VisibleStartMinute, start);
        return new InteractionPreview(
            current.Kind,
            targetDate,
            start,
            Math.Min(GridMetrics.VisibleEndMinute, start + duration),
            calendarEvent.Title);
    }

    private CalendarInteractionIntent BuildIntent(PointerGesture current, InteractionPreview committedPreview)
    {
        var start = ToLocalDateTime(committedPreview.TargetDate, committedPreview.StartMinute);
        var end = ToLocalDateTime(committedPreview.TargetDate, committedPreview.EndMinute);
        if (current.Kind == CalendarPointerGestureKind.Selection)
        {
            return new SelectTimeRangeIntent(start, end, InteractionTimeZoneId);
        }

        var calendarEvent = current.CalendarEvent!;
        return current.Kind == CalendarPointerGestureKind.Resize
            ? new ResizeEventIntent(
                calendarEvent.Id,
                calendarEvent.OriginalStartUtc,
                calendarEvent.OriginalEndUtc,
                end,
                calendarEvent.InteractionTimeZoneId,
                calendarEvent.IsReadOnly)
            : MoveEventIntent.ToTime(
                calendarEvent.Id,
                calendarEvent.OriginalStartUtc,
                calendarEvent.OriginalEndUtc,
                start,
                end,
                calendarEvent.InteractionTimeZoneId);
    }

    private async Task HandleEventClickAsync(Guid eventId)
    {
        if (ConsumeSuppressedClick())
        {
            return;
        }

        eventClickCancellation?.Cancel();
        eventClickCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        eventClickCancellation = cancellation;
        try
        {
            await Task.Delay(220, cancellation.Token);
            await EventSelected.InvokeAsync(eventId);
        }
        catch (OperationCanceledException)
        {
            // 第二次点击会取消详情打开并改为直接编辑。
        }
    }

    private async Task HandleEventDoubleClickAsync(Guid eventId)
    {
        eventClickCancellation?.Cancel();
        if (EventEditRequested.HasDelegate)
        {
            await EventEditRequested.InvokeAsync(eventId);
        }
    }

    private async Task HandleDateClickAsync(DateOnly date, MouseEventArgs args)
    {
        if (ConsumeSuppressedClick())
        {
            return;
        }

        if (string.Equals(lastPointerType, "touch", StringComparison.OrdinalIgnoreCase))
        {
            await RequestQuickCreateAtPointerAsync(date, args);
            return;
        }

        await DateSelected.InvokeAsync(date);
    }

    private async Task RequestQuickCreateAtPointerAsync(DateOnly date, MouseEventArgs args)
    {
        ElementBounds bounds;
        try
        {
            bounds = await JS.InvokeAsync<ElementBounds>("moicalendarInteraction.getElementBounds", timedDaysElement);
        }
        catch (JSException)
        {
            var fallbackStart = Math.Clamp(
                DefaultScrollHour * 60,
                GridMetrics.VisibleStartMinute,
                GridMetrics.VisibleEndMinute - CalendarInteractionGeometry.MinimumTimedDurationMinutes);
            await IntentRequested.InvokeAsync(
                new SelectTimeRangeIntent(
                    ToLocalDateTime(date, fallbackStart),
                    ToLocalDateTime(
                        date,
                        Math.Min(GridMetrics.VisibleEndMinute, fallbackStart + 60)),
                    InteractionTimeZoneId));
            return;
        }

        var startMinute = Math.Min(
            CalendarInteractionGeometry.MinuteFromPointer(
                args.ClientY,
                bounds.Top,
                bounds.Height,
                metrics: GridMetrics),
            GridMetrics.VisibleEndMinute - CalendarInteractionGeometry.MinimumTimedDurationMinutes);
        var start = ToLocalDateTime(date, startMinute);
        var end = ToLocalDateTime(
            date,
            Math.Min(GridMetrics.VisibleEndMinute, startMinute + 60));
        await IntentRequested.InvokeAsync(
            new SelectTimeRangeIntent(start, end, InteractionTimeZoneId));
    }

    private bool ConsumeSuppressedClick()
    {
        if (!suppressNextClick)
        {
            return false;
        }

        suppressNextClick = false;
        return true;
    }

    private bool IsTouchWaiting(PointerGesture current) =>
        string.Equals(current.PointerType, "touch", StringComparison.OrdinalIgnoreCase) &&
        DateTimeOffset.UtcNow - current.StartedAt < TimeSpan.FromMilliseconds(TouchHoldMilliseconds);

    private bool IsInteracting(Guid eventId) =>
        gesture is { IsActive: true, CalendarEvent.Id: var activeId } && activeId == eventId;

    private static DateTime ToLocalDateTime(DateOnly date, int minute) =>
        minute >= CalendarMetrics.MinutesPerDay
            ? date.AddDays(1).ToDateTime(TimeOnly.MinValue)
            : date.ToDateTime(TimeOnly.MinValue).AddMinutes(minute);

    private string GetPreviewStyle(InteractionPreview item)
    {
        var position = TimeGridLayoutEngine.CalculateClippedPosition(
            item.StartMinute,
            Math.Max(item.StartMinute + 1, item.EndMinute),
            new TimeGridMetrics(
                GridMetrics.VisibleStartMinute,
                GridMetrics.VisibleEndMinute,
                CalendarInteractionGeometry.MinimumTimedDurationMinutes));
        return FormattableString.Invariant(
            $"--event-top:{position.TopPercentage:0.####}%;--event-height:{position.HeightPercentage:0.####}%;");
    }

    private static string FormatPreview(InteractionPreview item) =>
        $"{item.TargetDate:M月d日} {FormatMinute(item.StartMinute)}–{FormatMinute(item.EndMinute)}";

    private static string FormatMinute(int minute) => minute >= CalendarMetrics.MinutesPerDay
        ? "24:00"
        : $"{minute / 60:D2}:{minute % 60:D2}";

    private enum CalendarPointerGestureKind
    {
        Move,
        Resize,
        Selection
    }

    private sealed record PointerGesture(
        CalendarPointerGestureKind Kind,
        long PointerId,
        string PointerType,
        double StartX,
        double StartY,
        DateTimeOffset StartedAt,
        DateOnly OriginalDate,
        CalendarWeekTimedEvent? CalendarEvent,
        bool IsActive = false)
    {
        public static PointerGesture ForEvent(
            CalendarPointerGestureKind kind,
            CalendarWeekTimedEvent calendarEvent,
            DateOnly date,
            PointerEventArgs args,
            DateTimeOffset startedAt) =>
            new(kind, args.PointerId, args.PointerType, args.ClientX, args.ClientY, startedAt, date, calendarEvent);

        public static PointerGesture ForSelection(
            DateOnly date,
            PointerEventArgs args,
            DateTimeOffset startedAt) =>
            new(CalendarPointerGestureKind.Selection, args.PointerId, args.PointerType, args.ClientX, args.ClientY, startedAt, date, null);
    }

    private sealed record InteractionPreview(
        CalendarPointerGestureKind Kind,
        DateOnly TargetDate,
        int StartMinute,
        int EndMinute,
        string Label);

    private sealed record ElementBounds(double Left, double Top, double Width, double Height);
}
