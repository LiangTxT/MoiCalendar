@inject IJSRuntime JS

<section class="week-calendar" aria-label="@AriaLabel">
    @if (!WeekEvents.Days.Any(day => day.AllDayEvents.Count > 0 || day.TimedEvents.Count > 0))
    {
        <p class="week-empty" role="status">本周暂无事件，选择日期可新建事件。</p>
    }

    <div class="week-day-headings" role="row">
        <span class="week-corner" aria-hidden="true"></span>
        @foreach (var day in WeekEvents.Days)
        {
            <button class="week-day-heading @(day.Date.IsToday ? "today" : null)"
                    type="button"
                    aria-current="@(day.Date.IsToday ? "date" : null)"
                    aria-label="@($"在 {day.Date.Date:yyyy-MM-dd} 新建事件")"
                    @onclick="() => DateSelected.InvokeAsync(day.Date.Date)">
                <span>@day.Date.WeekdayLabel</span>
                <strong>@day.Date.Date.ToString("M月d日")</strong>
            </button>
        }
    </div>

    <div class="week-all-day-row">
        <strong class="week-section-label">全天</strong>
        <div class="week-all-day-days">
            @foreach (var day in WeekEvents.Days)
            {
                <div class="week-all-day-cell">
                    <span class="week-mobile-day-label">@FormatMobileDay(day.Date)</span>
                    @foreach (var calendarEvent in day.AllDayEvents)
                    {
                        <button class="week-all-day-event"
                                type="button"
                                title="@calendarEvent.Title"
                                @onclick="() => EventSelected.InvokeAsync(calendarEvent.Id)">
                            @if (calendarEvent.IsRecurring)
                            {
                                <span class="recurrence-indicator" title="重复事件" aria-label="重复事件">↻</span>
                            }
                            @calendarEvent.Title
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="week-timed-scroll">
        <div class="week-timed-layout">
            <div class="week-time-labels" aria-hidden="true">
                @foreach (var hour in TimeLabelHours)
                {
                    <span style="@GetTimeLabelStyle(hour)">@($"{hour:D2}:00")</span>
                }
            </div>

            <div class="week-timed-days">
                @foreach (var day in WeekEvents.Days)
                {
                    var eventLayouts = GetEventLayouts(day.TimedEvents);
                    <div class="week-timed-day" @onclick="() => DateSelected.InvokeAsync(day.Date.Date)">
                        <button class="week-mobile-day-heading @(day.Date.IsToday ? "today" : null)"
                                type="button"
                                aria-current="@(day.Date.IsToday ? "date" : null)"
                                @onclick="() => DateSelected.InvokeAsync(day.Date.Date)"
                                @onclick:stopPropagation="true">
                            @FormatMobileDay(day.Date)
                        </button>

                        @if (day.Date.IsToday)
                        {
                            <span class="current-time-line" style="@GetCurrentTimeStyle()" aria-hidden="true">
                                <span></span>
                            </span>
                        }

                        @foreach (var calendarEvent in day.TimedEvents)
                        {
                            <button class="week-timed-event"
                                    type="button"
                                    style="@GetTimedEventStyle(calendarEvent, eventLayouts[calendarEvent.Id])"
                                    title="@($"{calendarEvent.TimeLabel} {calendarEvent.Title}")"
                                    @onclick="() => EventSelected.InvokeAsync(calendarEvent.Id)"
                                    @onclick:stopPropagation="true">
                                <span>@calendarEvent.TimeLabel</span>
                                <strong>
                                    @if (calendarEvent.IsRecurring)
                                    {
                                        <span class="recurrence-indicator" title="重复事件" aria-label="重复事件">↻</span>
                                    }
                                    @calendarEvent.Title
                                </strong>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] TimeLabelHours = Enumerable.Range(0, 13)
        .Select(index => index * 2)
        .ToArray();

    [Parameter, EditorRequired]
    public CalendarWeekEventView WeekEvents { get; set; } = CalendarWeekEventView.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<Guid> EventSelected { get; set; }

    [Parameter]
    public EventCallback<DateOnly> DateSelected { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("moicalendarUi.scrollWeekToActiveHours");
        }
        catch (JSException)
        {
            // 滚动定位是渐进增强，不影响周视图读写。
        }
    }

    private static string GetTimedEventStyle(CalendarWeekTimedEvent calendarEvent, EventLayout layout) =>
        FormattableString.Invariant(
            $"--event-top:{calendarEvent.TopPercentage:0.####}%;--event-height:{calendarEvent.HeightPercentage:0.####}%;--event-column:{layout.Column};--event-columns:{layout.ColumnCount};");

    private static string GetTimeLabelStyle(int hour) =>
        FormattableString.Invariant($"--time-label-top:{hour * 100d / 24:0.####}%;");

    private static string GetCurrentTimeStyle() =>
        FormattableString.Invariant($"--current-time-top:{DateTime.Now.TimeOfDay.TotalMinutes * 100d / 1440:0.####}%;");

    private static IReadOnlyDictionary<Guid, EventLayout> GetEventLayouts(
        IReadOnlyList<CalendarWeekTimedEvent> events)
    {
        var result = new Dictionary<Guid, EventLayout>();
        var group = new List<(Guid Id, int Column)>();
        var columnEnds = new List<int>();
        var groupEnd = -1;

        void CompleteGroup()
        {
            var columnCount = Math.Max(1, columnEnds.Count);
            foreach (var item in group)
            {
                result[item.Id] = new EventLayout(item.Column, columnCount);
            }

            group.Clear();
            columnEnds.Clear();
        }

        foreach (var calendarEvent in events.OrderBy(item => item.StartMinute).ThenByDescending(item => item.DurationMinutes))
        {
            if (group.Count > 0 && calendarEvent.StartMinute >= groupEnd)
            {
                CompleteGroup();
                groupEnd = -1;
            }

            var column = columnEnds.FindIndex(endMinute => endMinute <= calendarEvent.StartMinute);
            if (column < 0)
            {
                column = columnEnds.Count;
                columnEnds.Add(calendarEvent.StartMinute + calendarEvent.DurationMinutes);
            }
            else
            {
                columnEnds[column] = calendarEvent.StartMinute + calendarEvent.DurationMinutes;
            }

            group.Add((calendarEvent.Id, column));
            groupEnd = Math.Max(groupEnd, calendarEvent.StartMinute + calendarEvent.DurationMinutes);
        }

        CompleteGroup();
        return result;
    }

    private static string FormatMobileDay(CalendarWeekDate date) =>
        $"{date.WeekdayLabel} {date.Date:M月d日}";

    private readonly record struct EventLayout(int Column, int ColumnCount);
}
