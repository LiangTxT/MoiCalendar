<div class="month-week-row" role="row">
    @foreach (var day in Week.Days)
    {
        @if (HideOutsideMonth && !day.Date.IsInActiveMonth)
        {
            <div class="calendar-date month-blank-date" role="gridcell" aria-label="非本月日期"></div>
        }
        else
        {
            <MonthDayCell Day="day"
                          Selected="@(day.Date.Date == SelectedDate)"
                          ActiveEventId="ActiveEventId"
                          IsDragTarget="@(day.Date.Date == DragTargetDate)"
                          DragPreview="@(day.Date.Date == DragTargetDate ? DragPreview : null)"
                          SelectDateRange="SelectDateRange"
                          OpenDay="OpenDay"
                          DatePointerUp="DatePointerUp"
                          DateKeyDown="DateKeyDown"
                          EventFocused="EventFocused"
                          EventPointerDown="EventPointerDown"
                          EventSelected="EventSelected"
                          EventEdit="EventEdit"
                          MoreRequested="MoreRequested" />
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CalendarMonthWeekLayout Week { get; set; } = null!;

    [Parameter] public bool HideOutsideMonth { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; }
    [Parameter] public Guid? ActiveEventId { get; set; }
    [Parameter] public DateOnly? DragTargetDate { get; set; }
    [Parameter] public MonthDragPreviewModel? DragPreview { get; set; }
    [Parameter] public EventCallback<SelectDateRangeIntent> SelectDateRange { get; set; }
    [Parameter] public EventCallback<DateOnly> OpenDay { get; set; }
    [Parameter] public EventCallback<MonthDatePointerArgs> DatePointerUp { get; set; }
    [Parameter] public EventCallback<MonthDateKeyboardArgs> DateKeyDown { get; set; }
    [Parameter] public EventCallback<Guid> EventFocused { get; set; }
    [Parameter] public EventCallback<MonthEventPointerArgs> EventPointerDown { get; set; }
    [Parameter] public EventCallback<CalendarOccurrenceReference> EventSelected { get; set; }
    [Parameter] public EventCallback<Guid> EventEdit { get; set; }
    [Parameter] public EventCallback<DateOnly> MoreRequested { get; set; }
}
