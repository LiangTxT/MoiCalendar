<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WasmApplicationEnvironmentName>Production</WasmApplicationEnvironmentName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Developer-specific browser configuration must not leak into publish artifacts. -->
    <Content Remove="wwwroot\appsettings.Local.json" />
    <Content Remove="wwwroot\appsettings.Managed.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoiCalendar.Core\MoiCalendar.Core.csproj" />
    <ProjectReference Include="..\MoiCalendar.Storage\MoiCalendar.Storage.csproj" />
    <ProjectReference Include="..\MoiCalendar.Sync\MoiCalendar.Sync.csproj" />
  </ItemGroup>

</Project>
