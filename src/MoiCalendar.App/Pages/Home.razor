    private static bool IsMonthTouchWaiting(MonthPointerGesture current) =>
        string.Equals(current.PointerType, "touch", StringComparison.OrdinalIgnoreCase) &&
        DateTimeOffset.UtcNow - current.StartedAt < TimeSpan.FromMilliseconds(350);

    private Task OpenEventDetailsAsync(Guid id) =>
        OpenEventDetailsCoreAsync(id, rememberFocus: true);

    private Task OpenEventDetailsAsync(CalendarOccurrenceReference occurrence) =>
        OpenEventDetailsCoreAsync(occurrence.Id, rememberFocus: true, occurrence);

    private async Task OpenEventDetailsCoreAsync(Guid id, bool rememberFocus, CalendarOccurrenceReference? occurrence = null)
    {
        if (rememberFocus && !CalendarOverlayTransitions.CanOpenEventFromCalendar(overlayState.Kind))
        {
            return;
        }
        var request = overlayRequests.BeginRequest();
        try
        {
            var calendarEvent = await EventService.GetByIdAsync(id);
            if (calendarEvent is null || !overlayRequests.IsCurrent(request) ||
                rememberFocus && !CalendarOverlayTransitions.CanOpenEventFromCalendar(overlayState.Kind))
            {
                return;
            }

            if (rememberFocus)
            {
                await RememberFocusAsync(captureAnchor: true);
            }
            if (!overlayRequests.IsCurrent(request) ||
                rememberFocus && !CalendarOverlayTransitions.CanOpenEventFromCalendar(overlayState.Kind))
            {
                return;
            }
            selectedEvent = calendarEvent;
            selectedOccurrence = occurrence;
            quickCreateDraft = null;
            detailError = null;
        }
        catch (EventRepositoryException exception)
        {
            if (overlayRequests.IsCurrent(request))
            {
                storageError = exception.Message;
            }
        }
    }

    private async Task OpenEventEditorAsync(CalendarOccurrenceReference occurrence)
    {
        eventClickCancellation?.Cancel();
        if (!CalendarOverlayTransitions.CanOpenEventFromCalendar(overlayState.Kind))
        {
            return;
        }
        var request = overlayRequests.BeginRequest();
        try
        {
            var calendarEvent = await EventService.GetByIdAsync(occurrence.Id);
            if (calendarEvent is null || !overlayRequests.IsCurrent(request))
            {
                return;
            }

            await RememberFocusAsync();
            if (!overlayRequests.IsCurrent(request))
            {
                return;
            }
            if (!string.IsNullOrWhiteSpace(calendarEvent.RecurrenceRule))
            {
                selectedOccurrence = occurrence;
                overlayState = CalendarOverlayTransitions.OpenRecurrenceScope(
                    calendarEvent,
                    CalendarRecurrenceAction.EditSeries,
                    occurrenceStartUtc: occurrence.StartUtc, occurrence: occurrence);
                detailError = null;
                return;
            }

            editingEventId = calendarEvent.Id;
            seriesExclusionCount = calendarEvent.ExcludedOccurrenceStartsUtc.Length;
            editorError = null;
            editor = EventService.CreateDraft(calendarEvent);
            selectedEvent = null;
            quickCreateDraft = null;
            overflowDate = null;
        }
        catch (EventRepositoryException exception)
        {
            if (overlayRequests.IsCurrent(request))
            {
                storageError = exception.Message;
            }
        }
    }

    private void EditSelectedEvent()
    {
        if (selectedEvent is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedEvent.RecurrenceRule))
        {
            overlayState = CalendarOverlayTransitions.OpenRecurrenceScope(
                selectedEvent,
                CalendarRecurrenceAction.EditSeries,
                occurrenceStartUtc: selectedOccurrence?.StartUtc, occurrence: selectedOccurrence);
            detailError = null;
            return;
        }

        editingEventId = selectedEvent.Id;
        editorError = null;
        editor = EventService.CreateDraft(selectedEvent);
        selectedEvent = null;
        detailError = null;
    }

