@page "/"
@implements IAsyncDisposable
@using MoiCalendar.App.Components
@inject CalendarEventService EventService
@inject ICalendarDataChangeNotifier DataChanges
@inject CalendarInteractionService InteractionService
@inject ICalendarViewPreferenceStore ViewPreferences
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>MoiCalendar</PageTitle>

<CascadingValue TValue="Guid?" Name="SelectedCalendarEventId" Value="focusedEventId">

<main id="main-content" tabindex="-1" class="calendar-workspace @(isSidebarOpen ? null : "sidebar-collapsed") @(selectedEvent is not null ? "inspector-open" : null)">
    @if (isSidebarOpen)
    {
        <MoiCalendar.App.Components.CalendarSidebar MainMonth="monthView.Month"
                                                     Today="today"
                                                     SelectedDate="selectedDate"
                                                     CalendarVisible="calendarVisible"
                                                     Close="ToggleSidebar"
                                                     ShowToday="ShowTodayAsync"
                                                     SelectDate="SelectDateAsync"
                                                     CalendarVisibilityChanged="SetCalendarVisibility" />
        <button class="sidebar-scrim" type="button" aria-label="关闭日历侧栏" @onclick="ToggleSidebar"></button>
    }

    <div class="calendar-main">
        <MoiCalendar.App.Components.CalendarToolbar SidebarOpen="isSidebarOpen"
                                                     PeriodTitle="@PeriodTitle"
                                                     CompactPeriodTitle="@CompactPeriodTitle"
                                                     MonthYear="displayedMonth.Year"
                                                     MonthNumber="displayedMonth.Month"
                                                     PreviousAriaLabel="@PreviousPeriodAriaLabel"
                                                     NextAriaLabel="@NextPeriodAriaLabel"
                                                     DisplayMode="displayMode"
                                                     ToggleSidebar="ToggleSidebar"
                                                     ShowToday="ShowTodayAsync"
                                                     ShowPrevious="ShowPreviousPeriodAsync"
                                                     ShowNext="ShowNextPeriodAsync"
                                                     CreateEvent="() => OpenQuickCreate(SelectedCreateDate)"
                                                     SearchRequested="OpenSearch"
                                                     ViewChanged="ShowDisplayMode" />

        <div class="calendar-content app-scrollable">
            @if (!string.IsNullOrWhiteSpace(LocalError))
            {
                <p class="storage-error" role="alert">@LocalError</p>
            }

            @if (!string.IsNullOrWhiteSpace(interactionMessage))
            {
                <div class="calendar-status-anchor">
                    <div @key="feedbackVersion" class="calendar-status-capsule @(interactionSucceeded ? "success" : "failure")"
                         role="@(interactionSucceeded ? "status" : "alert")" aria-atomic="true">
                        <svg class="calendar-status-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                            @if (interactionSucceeded)
                            {
                                <path d="m5 12 4 4L19 6" />
                            }
                            else
                            {
                                <circle cx="12" cy="12" r="9" /><path d="M12 7v6m0 3v1" />
                            }
                        </svg>
                        <span>@interactionMessage</span>
                        @if (!interactionSucceeded)
                        {
                            <button type="button" class="calendar-status-dismiss" aria-label="关闭提示" @onclick="DismissInteractionFeedback">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (isLoadingEvents)
            {
                <div class="calendar-loading" role="status">正在读取本地日历…</div>
            }
            else if (displayMode == CalendarViewMode.Month)
            {
        <section class="calendar" aria-label="@($"{MonthTitle}日历")">
            @if (displayMode == CalendarViewMode.Agenda)
            {
                <div class="calendar-empty-hint" role="status">
                    <span><strong>本月暂无日程</strong>，选择日期即可新建事件。</span>
                    <button class="primary-button" type="button" @onclick="() => OpenQuickCreate(AgendaCreateDate)">新建事件</button>
                </div>
            }

            <MoiCalendar.App.Components.ContinuousMonthView @ref="monthViewComponent"
                                                   PreviousPreviousLayout="previousPreviousMonthLayout"
                                                   PreviousLayout="previousMonthLayout"
                                                   Layout="monthLayout"
                                                   NextLayout="nextMonthLayout"
                                                   NextNextLayout="nextNextMonthLayout"
                                                   NavigationVersion="monthStreamNavigationVersion"
                                                   DisplayedMonth="displayedMonth"
                                                   NavigateToMonth="month => ShowMonthAsync(month, showLoading: false)"
                                                   SelectedDate="selectedDate"
                                                   ActiveEventId="@(monthGesture?.IsActive == true ? monthGesture.CalendarEvent.Id : null)"
                                                   DragTargetDate="monthPreview?.TargetDate"
                                                   DragPreview="monthPreview"
                                                   IsDirectManipulation="@(monthGesture?.IsActive == true)"
                                                   SelectDateRange="HandleCalendarInteractionAsync"
                                                   OpenDay="OpenMonthDay"
                                                   DatePointerUp="HandleMonthDatePointerUp"
                                                   DateKeyDown="HandleMonthDateKeyDown"
                                                   EventFocused="SetFocusedEvent"
                                                   EventPointerDown="HandleMonthEventPointerDown"
                                                   EventSelected="HandleMonthEventClickAsync"
                                                   EventEdit="OpenEventEditorAsync"
                                                   MoreRequested="OpenDayOverflow"
                                                   VisibleMonthChanged="ChangeVisibleMonthAsync"
                                                   DisplayedMonthChanged="SetDisplayedMonth"
                                                   PointerMove="HandleMonthPointerMoveAsync"
                                                   PointerUp="CommitMonthPointerInteractionAsync"
                                                   PointerCancel="CancelMonthPointerInteraction" />
        </section>
            }
            else if (displayMode == CalendarViewMode.Agenda)
            {
        <AgendaStream Month="monthView.Month" Today="today" TimeZoneId="@displayTimeZoneId"
                      ReloadVersion="agendaReloadVersion"
                      CalendarVisible="calendarVisible" EventSelected="HandleMonthEventClickAsync"
                      EventEdit="OpenEventEditorAsync" OpenDay="OpenMonthDay" CreateEvent="OpenQuickCreate"
                      VisibleMonthChanged="SetDisplayedMonth" />
            }
            else if (displayMode == CalendarViewMode.Week)
            {
        <MoiCalendar.App.Components.CalendarTimeGrid @key="displayMode"
                                                      WeekEvents="@(calendarVisible ? weekEvents : CalendarWeekEventView.Empty)"
                                                      SelectedDate="selectedDate"
                                                      SelectedEventId="focusedEventId"
                                                      InteractionTimeZoneId="@displayTimeZoneId"
                                                      AriaLabel="@($"{WeekTitle}周视图")"
                                                      PeriodKey="@($"week:{weekView.Week.StartDate:yyyy-MM-dd}")"
                                                      PagingEnabled="@(!HasOpenOverlay)"
                                                      PeriodChanged="NavigateTimelinePeriodAsync"
                                                      OverlayRequests="overlayRequests"
                                                      EventSelected="OpenEventDetailsAsync"
                                                      EventFocused="SetFocusedEvent"
                                                      EventEditRequested="OpenEventEditorAsync"
                                                      DateSelected="SelectTimelineDate"
                                                      IntentRequested="HandleCalendarInteractionAsync" />
            }
            else
            {
        <MoiCalendar.App.Components.CalendarTimeGrid @key="displayMode"
                                                      WeekEvents="@(calendarVisible ? weekEvents : CalendarWeekEventView.Empty)"
                                                      VisibleDate="selectedDate"
                                                      SelectedDate="selectedDate"
                                                      SelectedEventId="focusedEventId"
                                                      InteractionTimeZoneId="@displayTimeZoneId"
                                                      AriaLabel="@($"{DayTitle}日视图")"
                                                      PeriodKey="@($"day:{selectedDate:yyyy-MM-dd}")"
                                                      PagingEnabled="@(!HasOpenOverlay)"
                                                      PeriodChanged="NavigateTimelinePeriodAsync"
                                                      OverlayRequests="overlayRequests"
                                                      EventSelected="OpenEventDetailsAsync"
                                                      EventFocused="SetFocusedEvent"
                                                      EventEditRequested="OpenEventEditorAsync"
                                                      DateSelected="SelectTimelineDate"
                                                      IntentRequested="HandleCalendarInteractionAsync" />
            }
        </div>
    </div>

    @if (selectedEvent is not null)
    {
        <MoiCalendar.App.Components.EventDetailPopover CalendarEvent="selectedEvent"
                                                        TimeText="@FormatSelectedEventTime(selectedEvent)"
                                                        Error="@detailError"
                                                        IsDeleting="isDeletingFromDetails"
                                                        Edit="EditSelectedEvent"
                                                        Delete="DeleteSelectedEventAsync"
                                                        Close="CloseEventDetails" />
    }
</main>
</CascadingValue>

@if (HasOpenOverlay)
{
<CalendarOverlayHost @key="overlayState.Kind"
                     State="overlayState"
                     Close="CloseCurrentOverlayAsync">
@if (quickCreateDraft is not null)
{
    <MoiCalendar.App.Components.EventQuickCreate Draft="quickCreateDraft"
                                                        Error="@quickCreateError"
                                                        IsSaving="isQuickCreating"
                                                        Create="CreateQuickEventAsync"
                                                        MoreDetails="PromoteQuickCreateToEditor"
                                                        Close="CloseQuickCreate" />
}

@if (overflowDate is DateOnly overflowDay)
{
        <section class="day-overflow-popover app-scrollable scrollbar-subtle"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="day-overflow-title"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>@FormatWeekday(overflowDay.DayOfWeek)</span>
                    <h2 id="day-overflow-title">@overflowDay.Month 月 @overflowDay.Day 日</h2>
                </div>
                <button class="icon-button" type="button" aria-label="关闭当天事件列表" @onclick="CloseDayOverflow">×</button>
            </header>
            <div class="overflow-event-list overflow-density-regular">
                @foreach (var calendarEvent in GetOverflowEvents(overflowDay, compact: false))
                {
                    <button class="agenda-event @(calendarEvent.IsAllDay ? "all-day" : null)"
                            style="@GetCalendarColorStyle(calendarEvent)"
                            type="button"
                            @onfocus="() => SetFocusedEvent(new CalendarOccurrenceReference(calendarEvent.Id, calendarEvent.OriginalStartUtc, calendarEvent.OriginalEndUtc))"
                            @onclick="() => OpenEventDetailsFromOverflowAsync(new CalendarOccurrenceReference(calendarEvent.Id, calendarEvent.OriginalStartUtc, calendarEvent.OriginalEndUtc))">
                        <span class="agenda-event-time">@calendarEvent.TimeLabel</span>
                        <span class="agenda-event-title">@calendarEvent.Title</span>
                    </button>
                }
            </div>
            <div class="overflow-event-list overflow-density-compact">
                @foreach (var calendarEvent in GetOverflowEvents(overflowDay, compact: true))
                {
                    <button class="agenda-event @(calendarEvent.IsAllDay ? "all-day" : null)"
                            style="@GetCalendarColorStyle(calendarEvent)"
                            type="button"
                            @onfocus="() => SetFocusedEvent(new CalendarOccurrenceReference(calendarEvent.Id, calendarEvent.OriginalStartUtc, calendarEvent.OriginalEndUtc))"
                            @onclick="() => OpenEventDetailsFromOverflowAsync(new CalendarOccurrenceReference(calendarEvent.Id, calendarEvent.OriginalStartUtc, calendarEvent.OriginalEndUtc))">
                        <span class="agenda-event-time">@calendarEvent.TimeLabel</span>
                        <span class="agenda-event-title">@calendarEvent.Title</span>
                    </button>
                }
            </div>
            <footer>
                <button class="primary-button" type="button" @onclick="() => OpenQuickCreateFromOverflow(overflowDay)">新建事件</button>
            </footer>
        </section>
}

@if (overlayState is SearchOverlayState)
{
        <section class="calendar-search-popover app-scrollable scrollbar-subtle"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="calendar-search-title"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span class="v4-meta">SEARCH / LOCAL</span>
                    <h2 id="calendar-search-title">搜索当前月份</h2>
                </div>
                <button class="icon-button" type="button" aria-label="关闭搜索" @onclick="CloseCurrentOverlayAsync">×</button>
            </header>
            <label class="visually-hidden" for="calendar-search-input">搜索标题或地点</label>
            <input id="calendar-search-input"
                   type="search"
                   autofocus
                   placeholder="搜索标题或地点"
                   @bind="searchQuery"
                   @bind:event="oninput" />
            <div class="calendar-search-results" role="list">
                @if (string.IsNullOrWhiteSpace(searchQuery))
                {
                    <p>输入关键词以筛选当前月份的本地事件。</p>
                }
                else if (SearchResults.Count == 0)
                {
                    <p>没有匹配的事件。</p>
                }
                else
                {
                    @foreach (var calendarEvent in SearchResults)
                    {
                        <button type="button"
                                role="listitem"
                                @onclick="() => OpenEventDetailsFromSearchAsync(new CalendarOccurrenceReference(calendarEvent.Id, calendarEvent.OriginalStartUtc, calendarEvent.OriginalEndUtc))">
                            <span>@calendarEvent.TimeLabel</span>
                            <strong>@calendarEvent.Title</strong>
                        </button>
                    }
                }
            </div>
        </section>
}

@if (overlayState is RecurrenceScopeOverlayState recurrenceScope)
{
    <RecurrenceScopeChooser CalendarEvent="recurrenceScope.CalendarEvent"
                            Action="recurrenceScope.Action"
                            Error="@detailError"
                            Busy="isDeletingFromDetails"
                            OccurrenceStartUtc="recurrenceScope.OccurrenceStartUtc"
                            OccurrenceTimeText="@FormatSelectedEventTime(recurrenceScope.CalendarEvent)"
                            DeleteOccurrence="DeleteSelectedOccurrenceAsync"
                            EditOccurrence="EditSelectedOccurrence"
                            Confirm="ConfirmRecurrenceScopeAsync"
                            Cancel="CloseCurrentOverlayAsync" />
}

@if (editor is not null)
{
        <section class="event-editor app-scrollable"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="event-editor-title"
                 @onclick:stopPropagation="true">
            <header class="editor-heading">
                <h2 id="event-editor-title">@(EditingOccurrence is not null ? "仅编辑这一次" : editingEventId is null ? "新建事件" : IsEditingRecurringEvent ? "编辑重复事件" : "编辑事件")</h2>
                <button class="icon-button" type="button" aria-label="关闭事件编辑器" disabled="@isSavingEvent" @onclick="CloseEditor">×</button>
            </header>

            @if (editingEventId is not null && IsEditingRecurringEvent)
            {
                <p class="recurrence-series-notice" role="status">
                    这是重复事件系列。保存或删除将影响整个系列。
                </p>
                @if (seriesExclusionCount > 0)
                {
                    <p class="recurrence-series-notice">已单独删除 @seriesExclusionCount 次；重复次数包含这些已删除的日期。</p>
                }
            }

            @if (EditingOccurrence is not null)
            {
                <p class="recurrence-series-notice" role="status">仅修改所选这一次，保存后成为独立日程。其他重复日程不变。</p>
            }

            <form @onsubmit="SaveEventAsync" @onsubmit:preventDefault="true">
                <fieldset class="editor-inputs" disabled="@isSavingEvent">
                <section class="editor-group primary-fields" aria-label="基本信息">
                <label class="visually-hidden" for="event-title">标题</label>
                <input id="event-title"
                       class="event-title-input"
                       type="text"
                       maxlength="200"
                       required
                       autofocus
                       @bind="editor.Title"
                       @bind:event="oninput" />

                <div class="editor-row">
                    <span>全天</span>
                    <label class="toggle-control" for="event-all-day">
                        <input id="event-all-day"
                               type="checkbox"
                               checked="@editor.IsAllDay"
                               @onchange="ChangeAllDay" />
                        <span aria-hidden="true"></span>
                        <span class="visually-hidden">全天事件</span>
                    </label>
                </div>

                <EventDateTimeFields Draft="editor" />
                <p id="editor-date-time-hint" class="date-time-input-hint">单击选择日期或时间，双击直接输入</p>
                </section>

                <section class="editor-group" aria-label="更多信息">
                <EventColorPicker @bind-Value="editor.ColorIndex" />
                <EventReminderPicker Draft="editor" />
                <div class="editor-row">
                    <label for="event-repeat">重复</label>
                    <select id="event-repeat"
                            disabled="@(EditingOccurrence is not null)"
                            value="@editor.Recurrence.RepeatOption"
                            @onchange="ChangeRepeatOption">
                        <option value="@CalendarEventRepeatOption.Never">永不</option>
                        <option value="@CalendarEventRepeatOption.Daily">每天</option>
                        <option value="@CalendarEventRepeatOption.Weekly">每周</option>
                        <option value="@CalendarEventRepeatOption.Monthly">每月</option>
                        <option value="@CalendarEventRepeatOption.Yearly">每年</option>
                        <option value="@CalendarEventRepeatOption.Custom">自定义</option>
                    </select>
                </div>

                @if (editor.Recurrence.RepeatOption == CalendarEventRepeatOption.Custom)
                {
                    <fieldset class="recurrence-fields">
                        <legend>自定义重复</legend>

                        <div class="recurrence-interval-row">
                            <span>每</span>
                            <input id="event-recurrence-interval"
                                   type="number"
                                   min="1"
                                   max="999"
                                   required
                                   aria-label="重复间隔"
                                   @bind="editor.Recurrence.Interval"
                                   @bind:event="oninput" />
                            <select aria-label="重复频率"
                                    value="@editor.Recurrence.CustomFrequency"
                                    @onchange="ChangeCustomFrequency">
                                <option value="@RecurrenceFrequency.Daily">天</option>
                                <option value="@RecurrenceFrequency.Weekly">周</option>
                                <option value="@RecurrenceFrequency.Monthly">月</option>
                                <option value="@RecurrenceFrequency.Yearly">年</option>
                            </select>
                        </div>

                        @if (editor.Recurrence.CustomFrequency == RecurrenceFrequency.Weekly)
                        {
                            <fieldset class="recurrence-weekdays">
                                <legend>重复日期</legend>
                                @foreach (var weekday in RecurrenceWeekdays)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@editor.Recurrence.IsWeekdaySelected(weekday.Day)"
                                               @onchange="args => ChangeRecurrenceWeekday(weekday.Day, args)" />
                                        @weekday.Label
                                    </label>
                                }
                            </fieldset>
                        }

                        <label for="event-recurrence-end">结束</label>
                        <select id="event-recurrence-end" @bind="editor.Recurrence.EndOption">
                            <option value="@RecurrenceEndOption.Never">永不</option>
                            <option value="@RecurrenceEndOption.OnDate">在指定日期</option>
                            <option value="@RecurrenceEndOption.AfterCount">重复指定次数后</option>
                        </select>

                        @if (editor.Recurrence.EndOption == RecurrenceEndOption.OnDate)
                        {
                            <label for="event-recurrence-until">结束日期</label>
                            <input id="event-recurrence-until"
                                   data-date-time-picker
                                   type="@RecurrenceDateInputType"
                                   required
                                   @bind="editor.Recurrence.UntilDateInput" />
                        }
                        else if (editor.Recurrence.EndOption == RecurrenceEndOption.AfterCount)
                        {
                            <label for="event-recurrence-count">重复次数</label>
                            <input id="event-recurrence-count"
                                   type="number"
                                   min="1"
                                   max="1000000"
                                   required
                                   @bind="editor.Recurrence.OccurrenceCount"
                                   @bind:event="oninput" />
                        }
                    </fieldset>
                }

                <div class="editor-row text-row">
                    <label for="event-location">地点</label>
                    <input id="event-location"
                           type="text"
                           maxlength="300"
                           placeholder="添加地点"
                           @bind="editor.Location"
                           @bind:event="oninput" />
                </div>

                <div class="editor-row text-row notes-row">
                    <label for="event-description">备注</label>
                    <textarea id="event-description" class="app-scrollable scrollbar-subtle"
                              rows="3"
                              maxlength="4000"
                              placeholder="添加备注"
                              @bind="editor.Description"
                              @bind:event="oninput"></textarea>
                </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(editorError))
                {
                    <p class="editor-error" role="alert">@editorError</p>
                }

                </fieldset>
                <footer class="editor-actions">
                    @if (editingEventId is not null)
                    {
                        <button class="danger-button" type="button" disabled="@isSavingEvent" @onclick="DeleteEventAsync">
                            @(IsEditingRecurringEvent ? "删除整个系列" : "删除")
                        </button>
                    }
                    <span class="action-spacer"></span>
                    <button type="button" disabled="@isSavingEvent" @onclick="CloseEditor">取消</button>
                    <button class="primary-button" type="submit" disabled="@isSavingEvent">
                        @(isSavingEvent ? "正在保存…" : EditingOccurrence is not null ? "保存这一次" : IsEditingRecurringEvent ? "保存整个系列" : "保存")
                    </button>
                </footer>
            </form>
        </section>
}
</CalendarOverlayHost>
}

@code {
    private static readonly (DayOfWeek Day, string Label)[] RecurrenceWeekdays =
    [
        (DayOfWeek.Monday, "一"),
        (DayOfWeek.Tuesday, "二"),
        (DayOfWeek.Wednesday, "三"),
        (DayOfWeek.Thursday, "四"),
        (DayOfWeek.Friday, "五"),
        (DayOfWeek.Saturday, "六"),
        (DayOfWeek.Sunday, "日")
    ];

    private DateOnly today;
    private DateOnly selectedDate;
    private string displayTimeZoneId = TimeZoneInfo.Utc.Id;
    private CalendarMonthView monthView = null!;
    private CalendarMonth displayedMonth;
    private readonly Dictionary<CalendarMonth, CalendarMonthEventView> monthEventCache = new();
    private readonly TimelineViewCache timelineViewCache = new();
    private CancellationTokenSource? timelinePrefetch;
    private int timelineNavigationVersion;
    private CalendarWeekView? pendingTimelineWeek;
    private DateOnly? pendingTimelineDate;
    private readonly Dictionary<(CalendarMonth Month, bool Visible), CalendarMonthLayoutView> monthLayoutCache = new();
    private int monthStreamNavigationVersion;
    private CalendarMonthEventView previousPreviousMonthEvents = CalendarMonthEventView.Empty;
    private CalendarMonthLayoutView previousPreviousMonthLayout = null!;
    private CalendarMonthEventView monthEvents = CalendarMonthEventView.Empty;
    private CalendarMonthLayoutView monthLayout = null!;
    private CalendarMonthEventView previousMonthEvents = CalendarMonthEventView.Empty;
    private CalendarMonthLayoutView previousMonthLayout = null!;
    private CalendarMonthEventView nextMonthEvents = CalendarMonthEventView.Empty;
    private CalendarMonthLayoutView nextMonthLayout = null!;
    private CalendarMonthEventView nextNextMonthEvents = CalendarMonthEventView.Empty;
    private CalendarMonthLayoutView nextNextMonthLayout = null!;
    private CalendarWeekView weekView = null!;
    private CalendarWeekEventView weekEvents = CalendarWeekEventView.Empty;
    private CalendarViewMode displayMode;
    private bool isInitialized;
    private readonly CalendarOverlayRequestGate overlayRequests = new();
    private CalendarOverlayState currentOverlayState = CalendarOverlayState.None;
    private CalendarOverlayState overlayState
    {
        get => currentOverlayState;
        set
        {
            overlayRequests.Invalidate();
            eventClickCancellation?.Cancel();
            currentOverlayState = value;
        }
    }
    private Guid? editingEventId;
    private bool isSavingEvent;
    private CalendarOccurrenceReference? EditingOccurrence => (overlayState as FullEditorOverlayState)?.Occurrence;
    private string searchQuery = string.Empty;
    private string? editorError;
    private string? quickCreateError;
    private string? detailError;
    private CalendarOccurrenceReference? selectedOccurrence
    {
        get => overlayState is EventDetailsOverlayState details ? details.Occurrence
            : (overlayState as RecurrenceScopeOverlayState)?.Occurrence;
        set
        {
            if (overlayState is EventDetailsOverlayState details) overlayState = details with { Occurrence = value };
        }
    }
    private string? detailAnchorStyle;
    private string? storageError;
    private string? preferenceError;
    private bool isLoadingEvents = true;
    private bool isQuickCreating;
    private bool isDeletingFromDetails;
    private bool calendarVisible = true;
    private bool isSidebarOpen = true;
    private bool viewportInitialized;
    private string? interactionMessage;
    private bool interactionSucceeded;
    private int feedbackVersion;
    private CancellationTokenSource? feedbackCancellation;
    private MoiCalendar.App.Components.ContinuousMonthView? monthViewComponent;
    private MonthPointerGesture? monthGesture;
    private MoiCalendar.App.Components.MonthDragPreviewModel? monthPreview;
    private bool suppressNextMonthClick;
    private DotNetObjectReference<Home>? shortcutReference;
    private CancellationTokenSource? eventClickCancellation;
    private Guid? focusedEventId;
    private CalendarOccurrenceReference? focusedOccurrence;
    private int seriesExclusionCount;

    private CalendarEventDraft? quickCreateDraft
    {
        get => (overlayState as QuickCreateOverlayState)?.Draft;
        set
        {
            if (value is not null && CalendarOverlayTransitions.CanOpenEventFromCalendar(overlayState.Kind))
            {
                overlayState = CalendarOverlayTransitions.OpenQuickCreate(value);
            }
            else if (overlayState is QuickCreateOverlayState)
            {
                overlayState = CalendarOverlayState.None;
            }
        }
    }

    private CalendarEvent? selectedEvent
    {
        get => (overlayState as EventDetailsOverlayState)?.CalendarEvent;
        set
        {
            if (value is not null)
            {
                overlayState = CalendarOverlayTransitions.OpenEventDetails(value);
            }
            else if (overlayState is EventDetailsOverlayState)
            {
                overlayState = CalendarOverlayState.None;
            }
        }
    }

    private DateOnly? overflowDate
    {
        get => (overlayState as MoreEventsOverlayState)?.Date;
        set
        {
            if (value is DateOnly date)
            {
                overlayState = CalendarOverlayTransitions.OpenMoreEvents(date);
            }
            else if (overlayState is MoreEventsOverlayState)
            {
                overlayState = CalendarOverlayState.None;
            }
        }
    }

    private CalendarEventDraft? editor
    {
        get => (overlayState as FullEditorOverlayState)?.Draft;
        set
        {
            if (value is not null)
            {
                overlayState = new FullEditorOverlayState(value);
            }
            else if (overlayState is FullEditorOverlayState)
            {
                overlayState = CalendarOverlayState.None;
            }
        }
    }

