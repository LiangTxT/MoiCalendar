    private async Task ConfirmRecurrenceScopeAsync()
    {
        if (overlayState is not RecurrenceScopeOverlayState scope)
        {
            return;
        }

        if (scope.Action == CalendarRecurrenceAction.DeleteSeries)
        {
            isDeletingFromDetails = true;
            detailError = null;
            try
            {
                await EventService.DeleteAsync(scope.CalendarEvent.Id);
                overlayState = CalendarOverlayState.None;
                interactionMessage = "重复事件系列已删除。";
                interactionSucceeded = true;
                await LoadEventsAsync();
                await RestoreFocusAsync();
            }
            catch (EventRepositoryException exception)
            {
                detailError = exception.Message;
            }
            finally
            {
                isDeletingFromDetails = false;
            }
            return;
        }

        editingEventId = scope.CalendarEvent.Id;
        editorError = scope.Action == CalendarRecurrenceAction.ApplyInteractionToSeries
            ? "请确认整个系列的新日期和时间后保存。"
            : null;
        editor = EventService.CreateDraft(scope.CalendarEvent);
    }

