    private void EditSelectedOccurrence()
    {
        if (overlayState is not RecurrenceScopeOverlayState { OccurrenceStartUtc: { } start } scope ||
            scope.Action is not (CalendarRecurrenceAction.EditSeries or CalendarRecurrenceAction.ApplyInteractionToSeries) ||
            selectedOccurrence is not { EndUtc: { } end }) return;
        try
        {
            var draft = scope.PendingIntent is { } pending
                ? InteractionService.PrepareOccurrenceInteractionDraft(scope.CalendarEvent, pending)
                : EventService.CreateDraft(scope.CalendarEvent with { StartUtc = start, EndUtc = end, RecurrenceRule = null });
            editingEventId = scope.CalendarEvent.Id;
            seriesExclusionCount = 0;
            editorError = null;
            detailError = null;
            overlayState = new FullEditorOverlayState(draft, new(scope.CalendarEvent.Id, start, end));
        }
        catch (ArgumentException exception)
        {
            detailError = exception.Message;
        }
    }

    private async Task DeleteSelectedEventAsync()
    {
        if (selectedEvent is null || isDeletingFromDetails)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedEvent.RecurrenceRule))
        {
            overlayState = CalendarOverlayTransitions.OpenRecurrenceScope(
                selectedEvent,
                CalendarRecurrenceAction.DeleteSeries,
                occurrenceStartUtc: selectedOccurrence?.StartUtc, occurrence: selectedOccurrence);
            detailError = null;
            return;
        }

        isDeletingFromDetails = true;
        detailError = null;
        try
        {
            await EventService.DeleteAsync(selectedEvent.Id);
            selectedEvent = null;
            ShowInteractionFeedback("已删除", true);
            await LoadEventsAsync();
            await RestoreFocusAsync();
        }
        catch (EventRepositoryException exception)
        {
            detailError = exception.Message;
        }
        finally
        {
            isDeletingFromDetails = false;
        }
    }

