    private async Task DeleteSelectedOccurrenceAsync()
    {
        if (isDeletingFromDetails || overlayState is not RecurrenceScopeOverlayState { Action: CalendarRecurrenceAction.DeleteSeries, OccurrenceStartUtc: { } start } scope) return;
        isDeletingFromDetails = true;
        detailError = null;
