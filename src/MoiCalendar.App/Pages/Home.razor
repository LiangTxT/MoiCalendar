@page "/"
@using MoiCalendar.Sync
@inject CalendarEventService EventService
@inject ISyncService SyncService
@inject ICalendarViewPreferenceStore ViewPreferences
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>MoiCalendar</PageTitle>

<main class="calendar-workspace @(isSidebarOpen ? null : "sidebar-collapsed")">
    @if (isSidebarOpen)
    {
        <MoiCalendar.App.Components.CalendarSidebar MainMonth="monthView.Month"
                                                     Today="today"
                                                     SelectedDate="selectedDate"
                                                     CalendarVisible="calendarVisible"
                                                     Close="ToggleSidebar"
                                                     ShowToday="ShowTodayAsync"
                                                     SelectDate="SelectDateAsync"
                                                     CalendarVisibilityChanged="SetCalendarVisibility" />
        <button class="sidebar-scrim" type="button" aria-label="关闭日历侧栏" @onclick="ToggleSidebar"></button>
    }

    <div class="calendar-main">
        <MoiCalendar.App.Components.CalendarToolbar SidebarOpen="isSidebarOpen"
                                                     PeriodTitle="@PeriodTitle"
                                                     PreviousAriaLabel="@PreviousPeriodAriaLabel"
                                                     NextAriaLabel="@NextPeriodAriaLabel"
                                                     DisplayMode="displayMode"
                                                     ToggleSidebar="ToggleSidebar"
                                                     ShowToday="ShowTodayAsync"
                                                     ShowPrevious="ShowPreviousPeriodAsync"
                                                     ShowNext="ShowNextPeriodAsync"
                                                     CreateEvent="() => OpenCreateEditor(SelectedCreateDate)"
                                                     ViewChanged="ShowDisplayMode" />

        <div class="calendar-content">
            <details class="calendar-onboarding">
                <summary>本地优先 · 离线可用</summary>
                <p>事件保存在此浏览器。跨设备同步、外部备份和数据导出可在设置中管理。</p>
                <a href="help">查看入门与备份说明</a>
            </details>

            <div class="calendar-utility-row">
                <a href="sync-status">查看云同步状态</a>
                <button type="button" disabled="@isSyncing" @onclick="SynchronizeAsync">
                    @(isSyncing ? "正在处理外部备份…" : "运行外部备份")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(syncMessage))
            {
                <p class="settings-status @(syncSucceeded ? "success" : "failure")" role="status">@syncMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(LocalError))
            {
                <p class="storage-error" role="alert">@LocalError</p>
            }

            @if (isLoadingEvents)
            {
                <div class="calendar-loading" role="status">正在读取本地日历…</div>
            }
            else if (!calendarVisible)
            {
                <section class="calendar-empty-state" role="status">
                    <h2>本地日历已隐藏</h2>
                    <p>在侧栏重新勾选“本地日历”即可显示事件。</p>
                    <button type="button" @onclick="() => SetCalendarVisibility(true)">显示本地日历</button>
                </section>
            }
            else if (displayMode == CalendarViewMode.Month)
            {
        <section class="calendar" aria-label="@($"{MonthTitle}日历")">
            <div class="weekday-grid" role="row">
                @foreach (var weekday in monthView.WeekdayLabels)
                {
                    <div class="weekday" role="columnheader">@FormatCompactWeekday(weekday)</div>
                }
            </div>

            <div class="month-grid" role="grid">
                @foreach (var date in monthView.Dates)
                {
                    <div class="@GetDateClass(date)"
                         role="gridcell"
                         tabindex="0"
                         aria-label="@date.Date.ToString("yyyy-MM-dd")"
                         aria-current="@(date.IsToday ? "date" : null)"
                         @onclick="() => OpenCreateEditor(date.Date)"
                         @onkeydown="args => HandleDateKey(args, date.Date)">
                        <span class="date-number">@date.DayNumber</span>

                        <div class="day-events">
                            @foreach (var calendarEvent in GetVisibleMonthEvents(date.Date))
                            {
                                <button class="event-chip"
                                        type="button"
                                        title="@calendarEvent.Title"
                                        @onclick="() => OpenEventDetailsAsync(calendarEvent.Id)"
                                        @onclick:stopPropagation="true">
                                    <span class="event-time">@calendarEvent.TimeLabel</span>
                                    @if (calendarEvent.IsRecurring)
                                    {
                                        <span class="recurrence-indicator" title="重复事件" aria-label="重复事件">↻</span>
                                    }
                                    <span class="event-title">@calendarEvent.Title</span>
                                </button>
                            }
                            @if (GetRemainingMonthEventCount(date.Date) > 0)
                            {
                                <button class="month-show-more"
                                        type="button"
                                        aria-label="@($"{date.Date:yyyy-MM-dd} 还有 {GetRemainingMonthEventCount(date.Date)} 个事件")"
                                        @onclick="() => OpenDayOverflow(date.Date)"
                                        @onclick:stopPropagation="true">＋@GetRemainingMonthEventCount(date.Date) 更多</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
            }
            else if (displayMode == CalendarViewMode.Agenda)
            {
        <section class="agenda" aria-label="@($"{MonthTitle}日程")">
            @if (agendaEvents.Days.Count == 0)
            {
                <div class="agenda-empty">
                    <h2>本月暂无日程</h2>
                    <p>这个月还没有任何事件。</p>
                    <button class="primary-button" type="button" @onclick="() => OpenCreateEditor(AgendaCreateDate)">新建事件</button>
                </div>
            }
            else
            {
                @foreach (var day in agendaEvents.Days)
                {
                    <article class="agenda-day">
                        <h2>
                            <time datetime="@day.Date.ToString("yyyy-MM-dd")">@FormatAgendaDate(day.Date)</time>
                        </h2>
                        <div class="agenda-events">
                            @foreach (var calendarEvent in GetVisibleAgendaEvents(day))
                            {
                                <button class="agenda-event @(calendarEvent.IsAllDay ? "all-day" : null)"
                                        type="button"
                                        title="@calendarEvent.Title"
                                        @onclick="() => OpenEventDetailsAsync(calendarEvent.Id)">
                                    <span class="agenda-event-time">@calendarEvent.TimeLabel</span>
                                    @if (calendarEvent.IsRecurring)
                                    {
                                        <span class="recurrence-indicator" title="重复事件" aria-label="重复事件">↻</span>
                                    }
                                    <span class="agenda-event-title">@calendarEvent.Title</span>
                                </button>
                            }

                            @if (GetRemainingAgendaEventCount(day) > 0)
                            {
                                <button class="agenda-show-more"
                                        type="button"
                                        @onclick="() => ShowMoreAgendaEvents(day)">
                                    显示更多（剩余 @GetRemainingAgendaEventCount(day) 项）
                                </button>
                            }
                        </div>
                    </article>
                }
            }
        </section>
            }
            else
            {
        <MoiCalendar.App.Components.CalendarWeekView WeekEvents="weekEvents"
                                                       AriaLabel="@($"{WeekTitle}周视图")"
                                                       EventSelected="OpenEventDetailsAsync"
                                                       DateSelected="OpenCreateEditor" />
            }
        </div>
    </div>
</main>

@if (selectedEvent is not null)
{
    <div class="editor-backdrop" @onclick="CloseEventDetails">
        <article class="event-popover"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="event-details-title"
                 @onclick:stopPropagation="true">
            <header>
                <span class="event-color-bar" aria-hidden="true"></span>
                <div>
                    <h2 id="event-details-title">@selectedEvent.Title</h2>
                    <p>@FormatEventTime(selectedEvent)</p>
                </div>
                <button class="icon-button" type="button" aria-label="关闭事件详情" @onclick="CloseEventDetails">×</button>
            </header>
            <dl class="event-detail-list">
                <dt>日历</dt><dd><span class="calendar-color" aria-hidden="true"></span>本地日历</dd>
                @if (!string.IsNullOrWhiteSpace(selectedEvent.Location))
                {
                    <dt>地点</dt><dd>@selectedEvent.Location</dd>
                }
                @if (!string.IsNullOrWhiteSpace(selectedEvent.Description))
                {
                    <dt>备注</dt><dd>@selectedEvent.Description</dd>
                }
                @if (!string.IsNullOrWhiteSpace(selectedEvent.RecurrenceRule))
                {
                    <dt>重复</dt><dd>重复事件系列</dd>
                }
            </dl>
            <footer>
                <button class="primary-button" type="button" @onclick="EditSelectedEvent">编辑</button>
            </footer>
        </article>
    </div>
}

@if (overflowDate is DateOnly overflowDay)
{
    <div class="editor-backdrop" @onclick="CloseDayOverflow">
        <section class="day-overflow-popover"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="day-overflow-title"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>@FormatWeekday(overflowDay.DayOfWeek)</span>
                    <h2 id="day-overflow-title">@overflowDay.Month 月 @overflowDay.Day 日</h2>
                </div>
                <button class="icon-button" type="button" aria-label="关闭当天事件列表" @onclick="CloseDayOverflow">×</button>
            </header>
            <div class="overflow-event-list">
                @foreach (var calendarEvent in monthEvents.GetEvents(overflowDay))
                {
                    <button class="agenda-event @(calendarEvent.IsAllDay ? "all-day" : null)"
                            type="button"
                            @onclick="() => OpenEventDetailsFromOverflowAsync(calendarEvent.Id)">
                        <span class="agenda-event-time">@calendarEvent.TimeLabel</span>
                        <span class="agenda-event-title">@calendarEvent.Title</span>
                    </button>
                }
            </div>
            <footer>
                <button class="primary-button" type="button" @onclick="() => OpenCreateFromOverflow(overflowDay)">新建事件</button>
            </footer>
        </section>
    </div>
}

@if (editor is not null)
{
    <div class="editor-backdrop" @onclick="CloseEditor">
        <section class="event-editor"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="event-editor-title"
                 @onclick:stopPropagation="true">
            <header class="editor-heading">
                <h2 id="event-editor-title">@(editingEventId is null ? "新建事件" : IsEditingRecurringEvent ? "编辑重复事件" : "编辑事件")</h2>
                <button class="icon-button" type="button" aria-label="关闭事件编辑器" @onclick="CloseEditor">×</button>
            </header>

            @if (editingEventId is not null && IsEditingRecurringEvent)
            {
                <p class="recurrence-series-notice" role="status">
                    这是重复事件系列。保存或删除将影响整个系列。
                </p>
            }

            <form @onsubmit="SaveEventAsync" @onsubmit:preventDefault="true">
                <section class="editor-group primary-fields" aria-label="基本信息">
                <label class="visually-hidden" for="event-title">标题</label>
                <input id="event-title"
                       class="event-title-input"
                       type="text"
                       maxlength="200"
                       required
                       autofocus
                       @bind="editor.Title"
                       @bind:event="oninput" />

                <div class="editor-row">
                    <span>全天</span>
                    <label class="toggle-control" for="event-all-day">
                        <input id="event-all-day"
                               type="checkbox"
                               checked="@editor.IsAllDay"
                               @onchange="ChangeAllDay" />
                        <span aria-hidden="true"></span>
                        <span class="visually-hidden">全天事件</span>
                    </label>
                </div>

                <div class="date-time-fields">
                    <div>
                        <label for="event-start">@(editor.IsAllDay ? "开始日期" : "开始日期/时间")</label>
                        <input id="event-start"
                               type="@EditorInputType"
                               required
                               @bind="editor.StartInput"
                               @bind:event="oninput" />
                    </div>
                    <div>
                        <label for="event-end">@(editor.IsAllDay ? "结束日期（不含）" : "结束日期/时间")</label>
                        <input id="event-end"
                               type="@EditorInputType"
                               required
                               @bind="editor.EndInput"
                               @bind:event="oninput" />
                    </div>
                </div>
                </section>

                <section class="editor-group" aria-label="更多信息">
                <div class="editor-row">
                    <label for="event-repeat">重复</label>
                    <select id="event-repeat"
                            value="@editor.Recurrence.RepeatOption"
                            @onchange="ChangeRepeatOption">
                        <option value="@CalendarEventRepeatOption.Never">永不</option>
                        <option value="@CalendarEventRepeatOption.Daily">每天</option>
                        <option value="@CalendarEventRepeatOption.Weekly">每周</option>
                        <option value="@CalendarEventRepeatOption.Monthly">每月</option>
                        <option value="@CalendarEventRepeatOption.Yearly">每年</option>
                        <option value="@CalendarEventRepeatOption.Custom">自定义</option>
                    </select>
                </div>

                @if (editor.Recurrence.RepeatOption == CalendarEventRepeatOption.Custom)
                {
                    <fieldset class="recurrence-fields">
                        <legend>自定义重复</legend>

                        <div class="recurrence-interval-row">
                            <span>每</span>
                            <input id="event-recurrence-interval"
                                   type="number"
                                   min="1"
                                   max="999"
                                   required
                                   aria-label="重复间隔"
                                   @bind="editor.Recurrence.Interval"
                                   @bind:event="oninput" />
                            <select aria-label="重复频率"
                                    value="@editor.Recurrence.CustomFrequency"
                                    @onchange="ChangeCustomFrequency">
                                <option value="@RecurrenceFrequency.Daily">天</option>
                                <option value="@RecurrenceFrequency.Weekly">周</option>
                                <option value="@RecurrenceFrequency.Monthly">月</option>
                                <option value="@RecurrenceFrequency.Yearly">年</option>
                            </select>
                        </div>

                        @if (editor.Recurrence.CustomFrequency == RecurrenceFrequency.Weekly)
                        {
                            <fieldset class="recurrence-weekdays">
                                <legend>重复日期</legend>
                                @foreach (var weekday in RecurrenceWeekdays)
                                {
                                    <label>
                                        <input type="checkbox"
                                               checked="@editor.Recurrence.IsWeekdaySelected(weekday.Day)"
                                               @onchange="args => ChangeRecurrenceWeekday(weekday.Day, args)" />
                                        @weekday.Label
                                    </label>
                                }
                            </fieldset>
                        }

                        <label for="event-recurrence-end">结束</label>
                        <select id="event-recurrence-end" @bind="editor.Recurrence.EndOption">
                            <option value="@RecurrenceEndOption.Never">永不</option>
                            <option value="@RecurrenceEndOption.OnDate">在指定日期</option>
                            <option value="@RecurrenceEndOption.AfterCount">重复指定次数后</option>
                        </select>

                        @if (editor.Recurrence.EndOption == RecurrenceEndOption.OnDate)
                        {
                            <label for="event-recurrence-until">结束日期</label>
                            <input id="event-recurrence-until"
                                   type="@RecurrenceDateInputType"
                                   required
                                   @bind="editor.Recurrence.UntilDateInput" />
                        }
                        else if (editor.Recurrence.EndOption == RecurrenceEndOption.AfterCount)
                        {
                            <label for="event-recurrence-count">重复次数</label>
                            <input id="event-recurrence-count"
                                   type="number"
                                   min="1"
                                   max="1000000"
                                   required
                                   @bind="editor.Recurrence.OccurrenceCount"
                                   @bind:event="oninput" />
                        }
                    </fieldset>
                }

                <div class="editor-row text-row">
                    <label for="event-location">地点</label>
                    <input id="event-location"
                           type="text"
                           maxlength="300"
                           placeholder="添加地点"
                           @bind="editor.Location"
                           @bind:event="oninput" />
                </div>

                <div class="editor-row text-row notes-row">
                    <label for="event-description">备注</label>
                    <textarea id="event-description"
                              rows="3"
                              maxlength="4000"
                              placeholder="添加备注"
                              @bind="editor.Description"
                              @bind:event="oninput"></textarea>
                </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(editorError))
                {
                    <p class="editor-error" role="alert">@editorError</p>
                }

                <footer class="editor-actions">
                    @if (editingEventId is not null)
                    {
                        <button class="danger-button" type="button" @onclick="DeleteEventAsync">
                            @(IsEditingRecurringEvent ? "删除整个系列" : "删除")
                        </button>
                    }
                    <span class="action-spacer"></span>
                    <button type="button" @onclick="CloseEditor">取消</button>
                    <button class="primary-button" type="submit">
                        @(IsEditingRecurringEvent ? "保存整个系列" : "保存")
                    </button>
                </footer>
            </form>
        </section>
    </div>
}

@code {
    private const int AgendaEventPageSize = 25;
    private const int MonthEventLimit = 3;
    private static readonly (DayOfWeek Day, string Label)[] RecurrenceWeekdays =
    [
        (DayOfWeek.Monday, "一"),
        (DayOfWeek.Tuesday, "二"),
        (DayOfWeek.Wednesday, "三"),
        (DayOfWeek.Thursday, "四"),
        (DayOfWeek.Friday, "五"),
        (DayOfWeek.Saturday, "六"),
        (DayOfWeek.Sunday, "日")
    ];

    private DateOnly today;
    private DateOnly selectedDate;
    private string displayTimeZoneId = TimeZoneInfo.Utc.Id;
    private CalendarMonthView monthView = null!;
    private CalendarMonthEventView monthEvents = CalendarMonthEventView.Empty;
    private CalendarAgendaView agendaEvents = CalendarAgendaView.Empty;
    private CalendarWeekView weekView = null!;
    private CalendarWeekEventView weekEvents = CalendarWeekEventView.Empty;
    private CalendarViewMode displayMode;
    private readonly Dictionary<DateOnly, int> visibleAgendaEventCounts = new();
    private bool isInitialized;
    private CalendarEventDraft? editor;
    private CalendarEvent? selectedEvent;
    private DateOnly? overflowDate;
    private Guid? editingEventId;
    private string? editorError;
    private string? storageError;
    private string? preferenceError;
    private string? syncMessage;
    private bool isLoadingEvents = true;
    private bool isSyncing;
    private bool syncSucceeded;
    private bool calendarVisible = true;
    private bool isSidebarOpen = true;
    private bool viewportInitialized;

    private string MonthTitle => $"{monthView.Month.Year}年{monthView.Month.Month}月";

    private string WeekTitle => FormatWeekTitle(weekView.Week);

    private string PeriodTitle => displayMode == CalendarViewMode.Week ? WeekTitle : MonthTitle;

    private string PreviousPeriodLabel => displayMode == CalendarViewMode.Week ? "< 上一周" : "< 上一月";

    private string NextPeriodLabel => displayMode == CalendarViewMode.Week ? "下一周 >" : "下一月 >";

    private string PreviousPeriodAriaLabel => displayMode == CalendarViewMode.Week ? "上一周" : "上一个月";

    private string NextPeriodAriaLabel => displayMode == CalendarViewMode.Week ? "下一周" : "下一个月";

    private string? LocalError => storageError ?? preferenceError;

    private DateOnly AgendaCreateDate =>
        monthView.Month == CalendarMonth.FromDate(today)
            ? today
            : new DateOnly(monthView.Month.Year, monthView.Month.Month, 1);

    private DateOnly SelectedCreateDate => selectedDate == default ? AgendaCreateDate : selectedDate;

    private string EditorInputType => editor?.IsAllDay == true ? "date" : "datetime-local";

    private const string RecurrenceDateInputType = "date";

    private bool IsEditingRecurringEvent =>
        editor?.Recurrence.RepeatOption is not null and not CalendarEventRepeatOption.Never;

    [SupplyParameterFromQuery(Name = "view")]
    public string? RequestedView { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var requestedMode = ParseRequestedView(RequestedView);

        if (!isInitialized)
        {
            today = DateOnly.FromDateTime(DateTime.Today);
            selectedDate = today;
            displayTimeZoneId = TimeZoneInfo.Local.Id;
            monthView = CalendarMonth.FromDate(today).CreateView(today);
            weekView = CalendarWeek.FromDate(today).CreateView(today);
            displayMode = requestedMode ?? await LoadPreferredViewAsync();
            isInitialized = true;
            if (requestedMode is not null)
            {
                await SavePreferredViewAsync(displayMode);
            }

            await LoadEventsAsync();
        }
        else if (requestedMode is { } mode && displayMode != mode)
        {
            displayMode = mode;
            await SavePreferredViewAsync(displayMode);
            await LoadEventsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || viewportInitialized)
        {
            return;
        }

        viewportInitialized = true;
        try
        {
            isSidebarOpen = await JS.InvokeAsync<bool>("moicalendarUi.isWideViewport");
            StateHasChanged();
        }
        catch (JSException)
        {
            // 保留服务端默认值；界面功能不依赖视口探测。
        }
    }

    private Task ShowPreviousPeriodAsync() => displayMode == CalendarViewMode.Week
        ? ShowWeekAsync(weekView.Week.Previous())
        : ShowMonthAsync(monthView.Month.Previous());

    private Task ShowNextPeriodAsync() => displayMode == CalendarViewMode.Week
        ? ShowWeekAsync(weekView.Week.Next())
        : ShowMonthAsync(monthView.Month.Next());

    private Task ShowTodayAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        selectedDate = today;
        return displayMode == CalendarViewMode.Week
            ? ShowWeekAsync(CalendarWeek.FromDate(today))
            : ShowMonthAsync(CalendarMonth.FromDate(today));
    }

    private async Task ShowMonthAsync(CalendarMonth month)
    {
        monthView = month.CreateView(today);
        await LoadEventsAsync();
    }

    private async Task ShowWeekAsync(CalendarWeek week)
    {
        weekView = week.CreateView(today);
        await LoadEventsAsync();
    }

    private void ShowDisplayMode(CalendarViewMode mode)
    {
        if (displayMode == mode)
        {
            return;
        }

        var view = mode switch
        {
            CalendarViewMode.Month => "month",
            CalendarViewMode.Week => "week",
            CalendarViewMode.Agenda => "agenda",
            _ => "month"
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", view));
    }

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private void SetCalendarVisibility(bool visible) => calendarVisible = visible;

    private async Task SelectDateAsync(DateOnly date)
    {
        selectedDate = date;
        if (displayMode == CalendarViewMode.Week)
        {
            await ShowWeekAsync(CalendarWeek.FromDate(date));
        }
        else
        {
            await ShowMonthAsync(CalendarMonth.FromDate(date));
        }
    }

    private async Task LoadEventsAsync()
    {
        isLoadingEvents = true;
        try
        {
            if (displayMode == CalendarViewMode.Month)
            {
                monthEvents = await EventService.GetMonthViewAsync(monthView, displayTimeZoneId);
            }
            else if (displayMode == CalendarViewMode.Agenda)
            {
                agendaEvents = await EventService.GetAgendaViewAsync(monthView.Month, displayTimeZoneId);
                visibleAgendaEventCounts.Clear();
            }
            else
            {
                weekEvents = await EventService.GetWeekViewAsync(weekView, displayTimeZoneId);
            }

            storageError = null;
        }
        catch (EventRepositoryException exception)
        {
            monthEvents = CalendarMonthEventView.Empty;
            agendaEvents = CalendarAgendaView.Empty;
            weekEvents = CalendarWeekEventView.Empty;
            storageError = exception.Message;
        }
        finally
        {
            isLoadingEvents = false;
        }
    }

    private async Task SynchronizeAsync()
    {
        isSyncing = true;
        syncMessage = null;

        try
        {
            var result = await SyncService.SynchronizeAsync();
            await LoadEventsAsync();
            syncSucceeded = true;
            syncMessage = $"外部备份处理完成：上传 {result.PushedCount} 项，下载 {result.DownloadedCount} 项，应用 {result.AppliedCount} 项。";
        }
        catch (Exception exception) when (exception is SyncStorageException or SyncOperationException or EventRepositoryException)
        {
            syncSucceeded = false;
            syncMessage = $"外部备份未完成：{exception.Message}";
        }
        finally
        {
            isSyncing = false;
        }
    }

    private void OpenCreateEditor(DateOnly date)
    {
        selectedDate = date;
        selectedEvent = null;
        overflowDate = null;
        editingEventId = null;
        editorError = null;
        editor = EventService.CreateDraft(date, displayTimeZoneId);
    }

    private async Task OpenEventDetailsAsync(Guid id)
    {
        try
        {
            var calendarEvent = await EventService.GetByIdAsync(id);
            if (calendarEvent is null)
            {
                return;
            }

            selectedEvent = calendarEvent;
            overflowDate = null;
        }
        catch (EventRepositoryException exception)
        {
            storageError = exception.Message;
        }
    }

    private void EditSelectedEvent()
    {
        if (selectedEvent is null)
        {
            return;
        }

        editingEventId = selectedEvent.Id;
        editorError = null;
        editor = EventService.CreateDraft(selectedEvent);
        selectedEvent = null;
    }

    private void CloseEventDetails() => selectedEvent = null;

    private void OpenDayOverflow(DateOnly date)
    {
        selectedDate = date;
        overflowDate = date;
    }

    private void CloseDayOverflow() => overflowDate = null;

    private async Task OpenEventDetailsFromOverflowAsync(Guid id)
    {
        overflowDate = null;
        await OpenEventDetailsAsync(id);
    }

    private void OpenCreateFromOverflow(DateOnly date)
    {
        overflowDate = null;
        OpenCreateEditor(date);
    }

    private void ChangeAllDay(ChangeEventArgs args)
    {
        if (editor is not null && args.Value is bool isAllDay)
        {
            editor.SetAllDay(isAllDay);
        }
    }

    private void ChangeRepeatOption(ChangeEventArgs args)
    {
        if (editor is null ||
            !Enum.TryParse<CalendarEventRepeatOption>(args.Value?.ToString(), out var repeatOption))
        {
            return;
        }

        editor.Recurrence.RepeatOption = repeatOption;
        EnsureCustomWeeklySelection();
    }

    private void ChangeCustomFrequency(ChangeEventArgs args)
    {
        if (editor is null ||
            !Enum.TryParse<RecurrenceFrequency>(args.Value?.ToString(), out var frequency))
        {
            return;
        }

        editor.Recurrence.CustomFrequency = frequency;
        EnsureCustomWeeklySelection();
    }

    private void EnsureCustomWeeklySelection()
    {
        if (editor is not null &&
            editor.Recurrence.RepeatOption == CalendarEventRepeatOption.Custom &&
            editor.Recurrence.CustomFrequency == RecurrenceFrequency.Weekly &&
            editor.Recurrence.SelectedWeekdays.Count == 0)
        {
            editor.Recurrence.SetWeekdaySelected(editor.StartLocal.DayOfWeek, true);
        }
    }

    private void ChangeRecurrenceWeekday(DayOfWeek weekday, ChangeEventArgs args)
    {
        if (editor is not null && args.Value is bool selected)
        {
            editor.Recurrence.SetWeekdaySelected(weekday, selected);
        }
    }

    private void HandleDateKey(KeyboardEventArgs args, DateOnly date)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenCreateEditor(date);
        }
    }

    private async Task SaveEventAsync()
    {
        if (editor is null)
        {
            return;
        }

        try
        {
            if (editingEventId is Guid id)
            {
                await EventService.UpdateAsync(id, editor);
            }
            else
            {
                await EventService.CreateAsync(editor);
            }

            CloseEditor();
            await LoadEventsAsync();
        }
        catch (ArgumentException exception)
        {
            editorError = exception.Message;
        }
        catch (KeyNotFoundException exception)
        {
            editorError = exception.Message;
        }
        catch (EventRepositoryException exception)
        {
            editorError = exception.Message;
        }
    }

    private async Task DeleteEventAsync()
    {
        if (editingEventId is not Guid id)
        {
            return;
        }

        try
        {
            await EventService.DeleteAsync(id);
            CloseEditor();
            await LoadEventsAsync();
        }
        catch (EventRepositoryException exception)
        {
            editorError = exception.Message;
        }
    }

    private void CloseEditor()
    {
        editor = null;
        editingEventId = null;
        editorError = null;
    }

    private string GetDateClass(CalendarDateCell date)
    {
        var classes = "calendar-date";

        if (!date.IsInActiveMonth)
        {
            classes += " outside-month";
        }

        if (date.IsToday)
        {
            classes += " today";
        }

        if (date.Date == selectedDate)
        {
            classes += " selected";
        }

        return classes;
    }

    private IEnumerable<CalendarEventListItem> GetVisibleMonthEvents(DateOnly date) =>
        monthEvents.GetEvents(date).Take(MonthEventLimit);

    private int GetRemainingMonthEventCount(DateOnly date) =>
        Math.Max(0, monthEvents.GetEvents(date).Count - MonthEventLimit);

    private string FormatEventTime(CalendarEvent calendarEvent)
    {
        var start = ConvertToDisplayTime(calendarEvent.StartUtc);
        var end = ConvertToDisplayTime(calendarEvent.EndUtc);

        if (calendarEvent.IsAllDay)
        {
            var startDate = DateOnly.FromDateTime(start.DateTime);
            var finalDate = DateOnly.FromDateTime(end.DateTime).AddDays(-1);
            return startDate == finalDate
                ? $"{startDate:yyyy年M月d日} · 全天"
                : $"{startDate:yyyy年M月d日}–{finalDate:yyyy年M月d日} · 全天";
        }

        return start.Date == end.Date
            ? $"{start:yyyy年M月d日 dddd HH:mm}–{end:HH:mm}"
            : $"{start:yyyy年M月d日 HH:mm}–{end:yyyy年M月d日 HH:mm}";
    }

    private DateTimeOffset ConvertToDisplayTime(DateTimeOffset value)
    {
        try
        {
            return TimeZoneInfo.ConvertTime(value, TimeZoneInfo.FindSystemTimeZoneById(displayTimeZoneId));
        }
        catch (TimeZoneNotFoundException)
        {
            return value.ToLocalTime();
        }
        catch (InvalidTimeZoneException)
        {
            return value.ToLocalTime();
        }
    }

    private static string FormatWeekday(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "星期一",
        DayOfWeek.Tuesday => "星期二",
        DayOfWeek.Wednesday => "星期三",
        DayOfWeek.Thursday => "星期四",
        DayOfWeek.Friday => "星期五",
        DayOfWeek.Saturday => "星期六",
        DayOfWeek.Sunday => "星期日",
        _ => string.Empty
    };

    private static string FormatCompactWeekday(string weekday) => weekday switch
    {
        "Mon" => "周一",
        "Tue" => "周二",
        "Wed" => "周三",
        "Thu" => "周四",
        "Fri" => "周五",
        "Sat" => "周六",
        "Sun" => "周日",
        _ => weekday
    };

    private static string FormatAgendaDate(DateOnly date)
    {
        var weekday = date.DayOfWeek switch
        {
            DayOfWeek.Monday => "星期一",
            DayOfWeek.Tuesday => "星期二",
            DayOfWeek.Wednesday => "星期三",
            DayOfWeek.Thursday => "星期四",
            DayOfWeek.Friday => "星期五",
            DayOfWeek.Saturday => "星期六",
            DayOfWeek.Sunday => "星期日",
            _ => string.Empty
        };

        return $"{date.Month}月{date.Day}日 {weekday}";
    }

    private IEnumerable<CalendarEventListItem> GetVisibleAgendaEvents(CalendarAgendaDay day) =>
        day.Events.Take(GetVisibleAgendaEventCount(day));

    private int GetVisibleAgendaEventCount(CalendarAgendaDay day) =>
        Math.Min(
            visibleAgendaEventCounts.GetValueOrDefault(day.Date, AgendaEventPageSize),
            day.Events.Count);

    private int GetRemainingAgendaEventCount(CalendarAgendaDay day) =>
        day.Events.Count - GetVisibleAgendaEventCount(day);

    private void ShowMoreAgendaEvents(CalendarAgendaDay day)
    {
        visibleAgendaEventCounts[day.Date] = Math.Min(
            GetVisibleAgendaEventCount(day) + AgendaEventPageSize,
            day.Events.Count);
    }

    private async Task<CalendarViewMode> LoadPreferredViewAsync()
    {
        try
        {
            preferenceError = null;
            return await ViewPreferences.GetAsync() ?? CalendarViewMode.Month;
        }
        catch (EventRepositoryException exception)
        {
            preferenceError = exception.Message;
            return CalendarViewMode.Month;
        }
    }

    private async Task SavePreferredViewAsync(CalendarViewMode viewMode)
    {
        try
        {
            await ViewPreferences.SaveAsync(viewMode);
            preferenceError = null;
        }
        catch (EventRepositoryException exception)
        {
            preferenceError = exception.Message;
        }
    }

    private static CalendarViewMode? ParseRequestedView(string? requestedView) =>
        requestedView?.ToLowerInvariant() switch
        {
            "month" => CalendarViewMode.Month,
            "week" => CalendarViewMode.Week,
            "agenda" => CalendarViewMode.Agenda,
            _ => null
        };

    private static string FormatWeekTitle(CalendarWeek week)
    {
        var start = week.StartDate;
        var end = week.EndDate;
        return start.Year == end.Year
            ? $"{start.Year}年{start.Month}月{start.Day}日–{end.Month}月{end.Day}日"
            : $"{start.Year}年{start.Month}月{start.Day}日–{end.Year}年{end.Month}月{end.Day}日";
    }
}
