    private int agendaReloadVersion;

    private async Task LoadEventsAsync(
        bool showLoading = true,
        CalendarMonth? requestedMonth = null,
        bool preserveMonthCache = false,
        CalendarWeekView? requestedWeek = null,
        DateOnly? requestedDate = null)
    {
        var timelineVersion = ++timelineNavigationVersion;
        pendingTimelineWeek = requestedWeek;
        pendingTimelineDate = requestedDate;
        timelinePrefetch?.Cancel();
        if (showLoading) timelineViewCache.Clear();
        if (showLoading)
        {
            isLoadingEvents = true;
            if (!preserveMonthCache)
            {
                monthEventCache.Clear();
                monthLayoutCache.Clear();
            }
        }
        try
        {
            if (displayMode == CalendarViewMode.Month)
            {
                var center = requestedMonth ?? monthView.Month;
                var months = new[]
                {
                    center.Previous().Previous(), center.Previous(), center,
                    center.Next(), center.Next().Next()
                };
                var views = months.Select(month => month.CreateView(today)).ToArray();
                var tasks = views.Select(GetCachedMonthEventsAsync).ToArray();
                await Task.WhenAll(tasks);
                var events = tasks.Select(task => task.Result).ToArray();

                monthView = views[2];
                previousPreviousMonthEvents = events[0];
                previousMonthEvents = events[1];
                monthEvents = events[2];
                nextMonthEvents = events[3];
                nextNextMonthEvents = events[4];
                previousPreviousMonthLayout = GetCachedMonthLayout(views[0], events[0]);
                previousMonthLayout = GetCachedMonthLayout(views[1], events[1]);
                monthLayout = GetCachedMonthLayout(views[2], events[2]);
                nextMonthLayout = GetCachedMonthLayout(views[3], events[3]);
                nextNextMonthLayout = GetCachedMonthLayout(views[4], events[4]);
                monthView = monthLayout.Month;

                foreach (var cachedMonth in monthEventCache.Keys.Where(month =>
                    Math.Abs((month.Year - center.Year) * 12 + month.Month - center.Month) > 4).ToArray())
                {
                    monthEventCache.Remove(cachedMonth);
                    monthLayoutCache.Remove((cachedMonth, true));
                    monthLayoutCache.Remove((cachedMonth, false));
                }
            }
            else if (displayMode == CalendarViewMode.Agenda)
            {
                ++agendaReloadVersion;
            }
            else
            {
                var targetWeek = requestedWeek ?? weekView;
                var events = await timelineViewCache.GetAsync(targetWeek, displayTimeZoneId,
                    (view, zone) => EventService.GetWeekViewAsync(view, zone));
                // 连续点击时，只提交最后一次导航；不让旧加载覆盖新日期。
                if (timelineVersion != timelineNavigationVersion) return;
                weekEvents = events;
                weekView = targetWeek;
                if (requestedDate is { } date)
                {
                    selectedDate = date;
                    if (displayMode == CalendarViewMode.Day)
                        monthView = CalendarMonth.FromDate(date).CreateView(today);
                }
                timelineViewCache.Trim(targetWeek.Week, displayTimeZoneId);
                timelinePrefetch?.Dispose();
                timelinePrefetch = new CancellationTokenSource();
                _ = PrefetchTimelineAsync(targetWeek.Week, displayTimeZoneId, timelinePrefetch.Token);
            }

            storageError = null;
        }
        catch (EventRepositoryException exception)
        {
            if (timelineVersion != timelineNavigationVersion) return;
            timelineViewCache.Clear();
            monthEventCache.Clear();
            monthLayoutCache.Clear();
            if (requestedMonth is { } failedMonth)
            {
                monthView = failedMonth.CreateView(today);
            }
            previousPreviousMonthEvents = CalendarMonthEventView.Empty;
            previousPreviousMonthLayout = previousPreviousMonthEvents.CreateLayout(monthView.Month.Previous().Previous().CreateView(today));
            monthEvents = CalendarMonthEventView.Empty;
            monthLayout = monthEvents.CreateLayout(monthView, includeEvents: calendarVisible);
            previousMonthEvents = CalendarMonthEventView.Empty;
            nextMonthEvents = CalendarMonthEventView.Empty;
            previousMonthLayout = previousMonthEvents.CreateLayout(monthView.Month.Previous().CreateView(today));
            nextMonthLayout = nextMonthEvents.CreateLayout(monthView.Month.Next().CreateView(today));
            nextNextMonthEvents = CalendarMonthEventView.Empty;
            nextNextMonthLayout = nextNextMonthEvents.CreateLayout(monthView.Month.Next().Next().CreateView(today));
            weekEvents = CalendarWeekEventView.Empty;
            storageError = exception.Message;
        }
        finally
        {
            if (timelineVersion == timelineNavigationVersion)
            {
                pendingTimelineWeek = null;
                pendingTimelineDate = null;
            }
            if (showLoading)
            {
                isLoadingEvents = false;
            }
        }
    }

    private async Task PrefetchTimelineAsync(CalendarWeek center, string zone, CancellationToken cancellation)
    {
        try
        {
            // 先让当前画面完成渲染，再预热前后周；不占用翻页首帧。
            await Task.Delay(400, cancellation);
            foreach (var week in new[] { center.Previous(), center.Next() })
            {
                cancellation.ThrowIfCancellationRequested();
                await timelineViewCache.GetAsync(week.CreateView(today), zone,
                    (view, timeZone) => EventService.GetWeekViewAsync(view, timeZone));
            }
            if (!cancellation.IsCancellationRequested) timelineViewCache.Trim(center, zone);
        }
        catch (OperationCanceledException) { }
        catch (EventRepositoryException) { /* 预热失败留待真实导航重试，并由前台显示错误。 */ }
    }

    private CalendarMonthLayoutView GetCachedMonthLayout(CalendarMonthView view, CalendarMonthEventView events)
    {
        var key = (view.Month, calendarVisible);
        if (!monthLayoutCache.TryGetValue(key, out var layout))
        {
            layout = events.CreateLayout(view, includeEvents: calendarVisible);
            monthLayoutCache[key] = layout;
        }
        return layout;
    }

    private async Task<CalendarMonthEventView> GetCachedMonthEventsAsync(CalendarMonthView view)
    {
        if (monthEventCache.TryGetValue(view.Month, out var cached))
        {
            return cached;
        }

        var events = await EventService.GetMonthViewAsync(view, displayTimeZoneId);
        monthEventCache[view.Month] = events;
        return events;
    }

