        }
        finally { isDeletingFromDetails = false; }
    }

    private async Task ConfirmRecurrenceScopeAsync()
    {
        if (isDeletingFromDetails || overlayState is not RecurrenceScopeOverlayState scope)
        {
            return;
        }

        if (scope.Action == CalendarRecurrenceAction.DeleteSeries)
        {
            isDeletingFromDetails = true;
            detailError = null;
            try
            {
                await EventService.DeleteAsync(scope.CalendarEvent.Id);
                overlayState = CalendarOverlayState.None;
                ShowInteractionFeedback("已删除系列", true);
                await LoadEventsAsync();
                await RestoreFocusAsync();
            }
            catch (EventRepositoryException exception)
            {
                detailError = exception.Message;
            }
            finally
            {
                isDeletingFromDetails = false;
            }
            return;
        }

        try
        {
            var draft = scope.PendingIntent is { } pending
                ? InteractionService.PrepareSeriesInteractionDraft(scope.CalendarEvent, pending)
                : EventService.CreateDraft(scope.CalendarEvent);
            editingEventId = scope.CalendarEvent.Id;
            seriesExclusionCount = scope.CalendarEvent.ExcludedOccurrenceStartsUtc.Length;
            editorError = null;
            detailError = null;
            editor = draft;
        }
        catch (ArgumentException exception)
        {
            detailError = exception.Message;
        }
    }

