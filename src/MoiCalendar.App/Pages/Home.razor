    private async Task SaveEventAsync()
    {
        if (editor is null || isSavingEvent)
        {
            return;
        }

        isSavingEvent = true;
        try
        {
            if (EditingOccurrence is { StartUtc: { } start } occurrence)
            {
                await EventService.UpdateOccurrenceAsync(occurrence.Id, start, editor);
            }
            else if (editingEventId is Guid id)
            {
                await EventService.UpdateAsync(id, editor);
            }
            else
            {
                await EventService.CreateAsync(editor);
            }

            isSavingEvent = false;
            var removedExceptions = editor.RemovedExclusionCount;
            await CloseEditor();
            await LoadEventsAsync();
            ShowInteractionFeedback(removedExceptions == 0 ? "已保存" : $"已保存；{removedExceptions} 个单次删除不再属于新规则，已清理。", true);
        }
        catch (ArgumentException exception)
        {
            editorError = exception.Message;
        }
        catch (KeyNotFoundException exception)
        {
            editorError = exception.Message;
        }
        catch (SyncOperationException)
        {
            editorError = "保存失败，本地事务未完成。你的输入已保留，请重试。";
        }
        catch (EventRepositoryException exception)
        {
            editorError = exception.Message;
        }
        finally
        {
            isSavingEvent = false;
        }
    }

    private async Task DeleteEventAsync()
    {
        if (editingEventId is not Guid id)
        {
            return;
        }

        try
        {
            var existing = await EventService.GetByIdAsync(id);
            if (existing is not null && !string.IsNullOrWhiteSpace(existing.RecurrenceRule))
            {
                detailError = null;
                var previousOverlay = overlayState;
                overlayState = new RecurrenceScopeOverlayState(existing, CalendarRecurrenceAction.DeleteSeries,
                    OccurrenceStartUtc: EditingOccurrence?.StartUtc, ReturnState: previousOverlay, Occurrence: EditingOccurrence);
                return;
            }
            await EventService.DeleteAsync(id);
            await CloseEditor();
            await LoadEventsAsync();
            ShowInteractionFeedback("已删除", true);
        }
        catch (EventRepositoryException exception)
        {
            editorError = exception.Message;
        }
    }

    private void DismissInteractionFeedback()
    {
        feedbackCancellation?.Cancel();
        feedbackCancellation?.Dispose();
        feedbackCancellation = null;
        interactionMessage = null;
    }

    private void ShowInteractionFeedback(string message, bool succeeded)
    {
        DismissInteractionFeedback();
        interactionMessage = message;
        interactionSucceeded = succeeded;
        feedbackVersion++;
        if (succeeded)
        {
            feedbackCancellation = new CancellationTokenSource();
            _ = HideInteractionFeedbackAsync(feedbackCancellation.Token);
        }
    }

    private async Task HideInteractionFeedbackAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(2200, cancellationToken);
            await InvokeAsync(() =>
            {
                if (!cancellationToken.IsCancellationRequested)
                {
                    interactionMessage = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // 新反馈或页面卸载会取消旧计时，避免清除后来的提示。
        }
    }

    private async Task CloseEditor()
    {
        if (isSavingEvent) return;
        editor = null;
        editingEventId = null;
        editorError = null;
        await RestoreFocusAsync();
    }

