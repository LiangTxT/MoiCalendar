    [SupplyParameterFromQuery(Name = "view")]
    public string? RequestedView { get; set; }
    [SupplyParameterFromQuery(Name = "date")]
    public string? RequestedDate { get; set; }
    private string? handledRequestedDate;

    protected override async Task OnParametersSetAsync()
    {
        var requestedMode = ParseRequestedView(RequestedView);
        if (RequestedDate is null) handledRequestedDate = null;

        if (!isInitialized)
        {
            today = DateOnly.FromDateTime(DateTime.Today);
            selectedDate = DateOnly.TryParseExact(RequestedDate, "yyyy-MM-dd", out var notificationDate) ? notificationDate : today;
            handledRequestedDate = RequestedDate;
            displayTimeZoneId = TimeZoneInfo.Local.Id;
            monthView = CalendarMonth.FromDate(today).CreateView(today);
            displayedMonth = monthView.Month;
            previousPreviousMonthLayout = previousPreviousMonthEvents.CreateLayout(monthView.Month.Previous().Previous().CreateView(today));
            monthLayout = monthEvents.CreateLayout(monthView);
            previousMonthLayout = previousMonthEvents.CreateLayout(monthView.Month.Previous().CreateView(today));
            nextMonthLayout = nextMonthEvents.CreateLayout(monthView.Month.Next().CreateView(today));
            nextNextMonthLayout = nextNextMonthEvents.CreateLayout(monthView.Month.Next().Next().CreateView(today));
            weekView = CalendarWeek.FromDate(selectedDate).CreateView(today);
            displayMode = requestedMode ?? await LoadPreferredViewAsync();
            isInitialized = true;
            if (requestedMode is not null)
            {
                await SavePreferredViewAsync(displayMode);
            }

            await LoadEventsAsync();
        }
        else if (RequestedDate != handledRequestedDate && DateOnly.TryParseExact(RequestedDate, "yyyy-MM-dd", out var notificationDate))
        {
            handledRequestedDate = RequestedDate;
            displayMode = requestedMode ?? CalendarViewMode.Day;
            await ShowDayAsync(notificationDate);
        }
        else if (requestedMode is { } mode && displayMode != mode)
        {
            displayMode = mode;
            await SavePreferredViewAsync(displayMode);
            await LoadEventsAsync();
        }
    }

    private bool disposed;

    protected override void OnInitialized() => DataChanges.Changed += OnSyncedDataChanged;

    private void OnSyncedDataChanged(object? sender, EventArgs args) => _ = RefreshSyncedEventsAsync();

    private async Task RefreshSyncedEventsAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (disposed || !isInitialized) return;
                timelinePrefetch?.Cancel();
                timelineViewCache.Clear();
                monthEventCache.Clear();
                monthLayoutCache.Clear();
                await LoadEventsAsync(showLoading: false);
                if (!disposed) StateHasChanged();
            });
        }
        catch (Exception) when (disposed) { }
        catch (EventRepositoryException) { /* The next refresh can retry; local data remains intact. */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        shortcutReference = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("moicalendarUi.initializeCalendarShortcuts", shortcutReference);
            if (!viewportInitialized)
            {
                viewportInitialized = true;
                isSidebarOpen = await JS.InvokeAsync<bool>("moicalendarUi.isWideViewport");
            }
            StateHasChanged();
        }
        catch (JSException)
        {
            // 保留服务端默认值；界面功能不依赖视口探测。
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        DataChanges.Changed -= OnSyncedDataChanged;
        ++timelineNavigationVersion;
        timelinePrefetch?.Cancel();
        timelinePrefetch?.Dispose();
        timelineViewCache.Clear();
        feedbackCancellation?.Cancel();
        feedbackCancellation?.Dispose();
        overlayRequests.Invalidate();
        eventClickCancellation?.Cancel();
        eventClickCancellation?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("moicalendarUi.disposeCalendarShortcuts");
        }
        catch (JSException)
        {
            // 页面卸载时浏览器连接可能已关闭。
        }

        shortcutReference?.Dispose();
    }

    [JSInvokable]
    public async Task HandleCalendarShortcut(
        string key,
        bool isTextEntry,
        bool controlKey,
        bool altKey,
        bool metaKey)
    {
        var action = CalendarShortcutPolicy.Resolve(
            key,
            isTextEntry,
            controlKey,
            altKey,
            metaKey);
        if (action is null)
        {
            return;
        }

        var overlayShortcutAllowed = action == CalendarShortcutAction.CloseOverlay ||
            selectedEvent is not null && action is (
                CalendarShortcutAction.OpenSelected or CalendarShortcutAction.DeleteSelected);
        if (HasOpenOverlay && !overlayShortcutAllowed)
        {
            return;
        }

        switch (action)
        {
            case CalendarShortcutAction.NewEvent:
                await OpenQuickCreate(SelectedCreateDate);
                break;
            case CalendarShortcutAction.Today:
                await ShowTodayAsync();
                break;
            case CalendarShortcutAction.MonthView:
                ShowDisplayMode(CalendarViewMode.Month);
                break;
            case CalendarShortcutAction.WeekView:
                ShowDisplayMode(CalendarViewMode.Week);
                break;
            case CalendarShortcutAction.DayView:
                ShowDisplayMode(CalendarViewMode.Day);
                break;
            case CalendarShortcutAction.AgendaView:
                ShowDisplayMode(CalendarViewMode.Agenda);
                break;
            case CalendarShortcutAction.PreviousPeriod:
                await ShowPreviousPeriodAsync();
                break;
            case CalendarShortcutAction.NextPeriod:
                await ShowNextPeriodAsync();
                break;
            case CalendarShortcutAction.CloseOverlay:
                await CloseCurrentOverlayAsync();
                break;
            case CalendarShortcutAction.OpenSelected when selectedEvent is not null:
                EditSelectedEvent();
                break;
            case CalendarShortcutAction.OpenSelected when focusedEventId is Guid focusedId:
                await OpenFocusedEventAsync(focusedId);
                break;
            case CalendarShortcutAction.DeleteSelected when selectedEvent is not null:
                await DeleteSelectedEventAsync();
                break;
            case CalendarShortcutAction.DeleteSelected when focusedEventId is Guid deleteId:
                await OpenFocusedEventAsync(deleteId);
                if (selectedEvent is not null) await DeleteSelectedEventAsync();
                break;
            case CalendarShortcutAction.Search:
                await OpenSearch();
                break;
        }
        // JSInvokable 不经过 Razor EventCallback，快捷键变更后需主动刷新。
        await InvokeAsync(StateHasChanged);
    }

    private bool HasOpenOverlay => overlayState.Kind is not (
        CalendarOverlayKind.None or CalendarOverlayKind.EventDetails);

    private async Task OpenSearch()
    {
        await RememberFocusAsync();
        searchQuery = string.Empty;
        overlayState = CalendarOverlayTransitions.OpenSearch();
    }

    private IReadOnlyList<CalendarEventListItem> SearchResults => monthLayout.Weeks
        .SelectMany(week => week.Days)
        .SelectMany(day => day.AllEvents)
        .DistinctBy(calendarEvent => (calendarEvent.Id, calendarEvent.OriginalStartUtc))
        .Where(calendarEvent => calendarEvent.Title.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase))
        .Take(20)
        .ToArray();

    private Task OpenEventDetailsFromSearchAsync(CalendarOccurrenceReference occurrence) =>
        OpenEventDetailsCoreAsync(occurrence.Id, rememberFocus: false, occurrence);

    private async Task CloseCurrentOverlayAsync()
    {
        if (isDeletingFromDetails && overlayState is RecurrenceScopeOverlayState) return;
        // 即使详情仍在读取、尚无可见弹层，Escape 也撤销待完成请求。
        overlayRequests.Invalidate();
        eventClickCancellation?.Cancel();
        if (editor is not null)
        {
            await CloseEditor();
        }
        else if (quickCreateDraft is not null)
        {
            await CloseQuickCreate();
        }
        else if (selectedEvent is not null)
        {
            await CloseEventDetails();
        }
        else if (overflowDate is not null)
        {
            await CloseDayOverflow();
        }
        else if (overlayState is RecurrenceScopeOverlayState)
        {
            overlayState = ((RecurrenceScopeOverlayState)overlayState).ReturnState ?? CalendarOverlayState.None;
            await RestoreFocusAsync();
        }
        else if (overlayState is SearchOverlayState)
        {
            overlayState = CalendarOverlayState.None;
            searchQuery = string.Empty;
            await RestoreFocusAsync();
        }
    }

    private async Task RememberFocusAsync(bool captureAnchor = false)
    {
        try
        {
            if (!captureAnchor)
            {
                await JS.InvokeVoidAsync("moicalendarUi.rememberCalendarFocus");
                detailAnchorStyle = null;
                return;
            }

            var bounds = await JS.InvokeAsync<CalendarElementBounds?>(
                "moicalendarUi.rememberCalendarFocusAndGetAnchor");
            detailAnchorStyle = bounds is null
                ? null
                : FormattableString.Invariant(
                    $"--popover-anchor-x:{bounds.Left + bounds.Width + 8:0.##}px;--popover-anchor-y:{bounds.Top:0.##}px;");
        }
        catch (JSException)
        {
            detailAnchorStyle = null;
        }
    }

    private async Task RestoreFocusAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("moicalendarUi.restoreCalendarFocus");
        }
        catch (JSException)
        {
            // 焦点恢复是渐进增强，不影响事件读写。
        }
    }

    private Task ShowPreviousPeriodAsync() => displayMode switch
    {
        CalendarViewMode.Week => ShowWeekAsync((pendingTimelineWeek ?? weekView).Week.Previous()),
        CalendarViewMode.Day => ShowDayAsync((pendingTimelineDate ?? selectedDate).AddDays(-1)),
        _ => ShowMonthAsync(displayedMonth.Previous())
    };

    private Task ShowNextPeriodAsync() => displayMode switch
    {
        CalendarViewMode.Week => ShowWeekAsync((pendingTimelineWeek ?? weekView).Week.Next()),
        CalendarViewMode.Day => ShowDayAsync((pendingTimelineDate ?? selectedDate).AddDays(1)),
        _ => ShowMonthAsync(displayedMonth.Next())
    };

    private Task ShowTodayAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        selectedDate = today;
        return displayMode switch
        {
            CalendarViewMode.Week => ShowWeekAsync(CalendarWeek.FromDate(today)),
            CalendarViewMode.Day => ShowDayAsync(today),
            _ => ShowMonthAsync(CalendarMonth.FromDate(today))
        };
    }

    private async Task ShowMonthAsync(CalendarMonth month, bool seamless = false, bool showLoading = true)
    {
        if (!seamless) focusedEventId = null;
        if (!seamless)
        {
            displayedMonth = month;
        }
        if (displayMode != CalendarViewMode.Month)
        {
            monthView = month.CreateView(today);
        }
        await LoadEventsAsync(showLoading: showLoading && !seamless, requestedMonth: month, preserveMonthCache: true);
        if (!seamless && displayMode == CalendarViewMode.Month)
        {
            monthStreamNavigationVersion++;
        }
    }

    private Task ChangeVisibleMonthAsync(int direction) =>
        direction < 0
            ? ShowMonthAsync(monthView.Month.Previous(), seamless: true)
            : ShowMonthAsync(monthView.Month.Next(), seamless: true);

