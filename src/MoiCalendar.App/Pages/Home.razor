    private async Task HandleCalendarInteractionAsync(CalendarInteractionIntent intent)
    {
        var result = await InteractionService.ExecuteAsync(intent);
        interactionMessage = result.Message;
        interactionSucceeded = result.Succeeded || result.Status == CalendarInteractionStatus.NoChange;

        if (result.Status == CalendarInteractionStatus.SelectionReady &&
            result.Intent is SelectTimeRangeIntent timeRange)
        {
            await OpenQuickCreate(timeRange.StartLocal, timeRange.EndLocal);
            return;
        }

        if (result.Status == CalendarInteractionStatus.SelectionReady &&
            result.Intent is SelectDateRangeIntent dateRange)
        {
            selectedDate = dateRange.StartDate;
            return;
        }

        if (result.Status == CalendarInteractionStatus.RecurrenceScopeRequired &&
            result.Intent is ICalendarEventInteractionIntent recurringIntent)
        {
            var recurringEvent = await EventService.GetByIdAsync(recurringIntent.EventId);
            if (recurringEvent is not null)
            {
                await RememberFocusAsync();
                overlayState = CalendarOverlayTransitions.OpenRecurrenceScope(
                    recurringEvent,
                    CalendarRecurrenceAction.ApplyInteractionToSeries,
                    result.Intent);
                detailError = null;
            }
            return;
        }

        if (result.Status is CalendarInteractionStatus.Committed or CalendarInteractionStatus.Failed)
        {
            await LoadEventsAsync();
        }
    }

    private void BeginMonthMove(CalendarEventListItem calendarEvent, DateOnly date, PointerEventArgs args)
    {
        if (args.Button != 0 || calendarEvent.IsReadOnly)
        {
            return;
        }

        monthGesture = new MonthPointerGesture(
            args.PointerId,
            args.PointerType,
            args.ClientX,
            args.ClientY,
            DateTimeOffset.UtcNow,
            date,
            calendarEvent);
    }

    private void HandleMonthEventPointerDown(MoiCalendar.App.Components.MonthEventPointerArgs args) =>
        BeginMonthMove(args.CalendarEvent, args.Date, args.PointerEvent);

    private async Task HandleMonthPointerMoveAsync(PointerEventArgs args)
    {
        if (monthGesture is not { } current || current.PointerId != args.PointerId)
        {
            return;
        }

        if (!current.IsActive)
        {
            if (!CalendarInteractionGeometry.HasExceededMovementThreshold(
                    current.StartX,
                    current.StartY,
                    args.ClientX,
                    args.ClientY) ||
                IsMonthTouchWaiting(current))
            {
                return;
            }

            current = current with { IsActive = true };
            monthGesture = current;
            try
            {
                await JS.InvokeVoidAsync("moicalendarInteraction.capturePointer", MonthGridElement, args.PointerId);
            }
            catch (JSException)
            {
                // 指针捕获失败时仍可在月网格范围内完成拖放。
            }
        }

        CalendarElementBounds bounds;
        try
        {
            bounds = await JS.InvokeAsync<CalendarElementBounds>("moicalendarInteraction.getElementBounds", MonthGridElement);
        }
        catch (JSException)
        {
            CancelMonthPointerInteraction();
            return;
        }

        var index = CalendarInteractionGeometry.MonthDateIndexFromPointer(
            args.ClientX,
            args.ClientY,
            bounds.Left,
            bounds.Top,
            bounds.Width,
            bounds.Height,
            monthView.Dates.Count);
        var targetDate = monthView.Dates[index].Date;
        monthPreview = new MoiCalendar.App.Components.MonthDragPreviewModel(
            targetDate,
            current.CalendarEvent.Title,
            current.CalendarEvent.TimeLabel);
    }

    private async Task CommitMonthPointerInteractionAsync(PointerEventArgs args)
    {
        if (monthGesture is not { IsActive: true } current ||
            current.PointerId != args.PointerId ||
            monthPreview is not { } committedPreview)
        {
            monthGesture = null;
            monthPreview = null;
            return;
        }

        suppressNextMonthClick = true;
        monthGesture = null;
        monthPreview = null;
        try
        {
            await JS.InvokeVoidAsync("moicalendarInteraction.releasePointer", MonthGridElement, args.PointerId);
        }
        catch (JSException)
        {
            // pointerup 会由浏览器完成最终释放。
        }

        await HandleCalendarInteractionAsync(
            MoveEventIntent.ToDate(
                current.CalendarEvent.Id,
                current.CalendarEvent.OriginalStartUtc,
                current.CalendarEvent.OriginalEndUtc,
                current.OriginalDate,
                committedPreview.TargetDate,
                current.CalendarEvent.InteractionTimeZoneId));
    }

    private void CancelMonthPointerInteraction()
    {
        monthGesture = null;
        monthPreview = null;
    }

    private async Task HandleMonthEventClickAsync(Guid eventId)
    {
        if (suppressNextMonthClick)
        {
            suppressNextMonthClick = false;
            return;
        }

        eventClickCancellation?.Cancel();
        eventClickCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        eventClickCancellation = cancellation;
        try
        {
            await Task.Delay(180, cancellation.Token);
            await OpenEventDetailsAsync(eventId);
        }
        catch (OperationCanceledException)
        {
            // 双击会取消轻量详情，直接进入完整编辑器。
        }
    }

