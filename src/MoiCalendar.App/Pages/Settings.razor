@page "/settings"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using MoiCalendar.App.Configuration
@using MoiCalendar.Sync
@using MoiCalendar.Sync.OneDrive
@inject ISyncProviderSelection ProviderSelection
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOneDriveConnectionTester OneDriveConnectionTester
@inject MoiCalendarConfiguration AppConfiguration
@inject NavigationManager Navigation
@inject ILocalBackupService LocalBackupService
@inject ILocalBackupRestoreService LocalBackupRestoreService
@inject ICalendarExportService ICalendarExportService
@inject ICalendarImportService ICalendarImportService
@inject IBrowserFileDownloadService BrowserFileDownloadService
@inject ISyncDiagnosticsService SyncDiagnosticsService

<PageTitle>设置 | MoiCalendar</PageTitle>

<main class="settings-shell">
    <h1>设置</h1>

    <fieldset class="settings-group">
        <legend>提供商</legend>

        <label>
            <input type="radio"
                   name="sync-provider"
                   checked="@(selectedProvider == SyncProviderType.None)"
                   @onchange="() => SelectProviderAsync(SyncProviderType.None)" />
            无
        </label>

        <label>
            <input type="radio"
                   name="sync-provider"
                   checked="@(selectedProvider == SyncProviderType.OneDrive)"
                   @onchange="() => SelectProviderAsync(SyncProviderType.OneDrive)" />
            OneDrive
        </label>

        <label>
            <input type="radio"
                   name="sync-provider"
                   checked="@(selectedProvider == SyncProviderType.WebDav)"
                   @onchange="() => SelectProviderAsync(SyncProviderType.WebDav)" />
            WebDAV
        </label>
    </fieldset>

    <section class="settings-card" aria-labelledby="onedrive-heading">
        <h2 id="onedrive-heading">OneDrive</h2>

        <p class="settings-status failure" role="alert">
            临时初始化模式已启用：登录期间会请求整个个人 OneDrive 的读写权限。
            Microsoft 修复 App Folder 问题后必须立即撤销此临时权限。
        </p>

        @if (!isAuthenticationConfigured)
        {
            <p class="settings-note">
                尚未配置 Microsoft 应用程序（客户端）ID。填写配置后即可登录。
            </p>
            <button type="button" disabled>登录</button>
        }
        else if (!isAuthenticated)
        {
            <p>登录个人 Microsoft 账户后，可以测试 OneDrive 应用文件夹连接。</p>
            <button type="button" class="primary-button" @onclick="SignIn">登录</button>
        }
        else
        {
            <dl class="account-information">
                <dt>已登录账户</dt>
                <dd>@accountDisplayName</dd>
                @if (!string.IsNullOrWhiteSpace(accountIdentifier) &&
                     !string.Equals(accountIdentifier, accountDisplayName, StringComparison.OrdinalIgnoreCase))
                {
                    <dt>账户信息</dt>
                    <dd>@accountIdentifier</dd>
                }
            </dl>

            <div class="settings-actions">
                <button type="button"
                        class="primary-button"
                        disabled="@isTestingConnection"
                        @onclick="TestConnectionAsync">
                    @(isTestingConnection ? "正在测试…" : "测试连接")
                </button>
                <button type="button" disabled="@isTestingConnection" @onclick="Disconnect">
                    断开连接
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(connectionMessage))
        {
            <p class="settings-status @(connectionSucceeded ? "success" : "failure")" role="status">
                @connectionMessage
            </p>
        }
    </section>

    <p class="settings-note">
        OneDrive 登录和连接成功后，可返回日历首页使用“立即同步”。WebDAV 需要先完成服务器连接配置。
    </p>

    @if (!string.IsNullOrWhiteSpace(providerStatusMessage))
    {
        <p class="settings-status" role="status">@providerStatusMessage</p>
    }

    <section class="settings-card" aria-labelledby="backup-heading">
        <h2 id="backup-heading">备份</h2>
        <p>
            将本机日历数据导出为版本化 JSON 文件。备份只在浏览器本地生成，不会上传到同步提供商。
        </p>
        <div class="settings-actions">
            <button type="button"
                    class="primary-button"
                    disabled="@(isExportingBackup || isRestoringBackup)"
                    @onclick="ExportBackupAsync">
                @(isExportingBackup ? "正在导出…" : "导出备份")
            </button>
            <label class="file-button @(isExportingBackup || isRestoringBackup ? "disabled" : null)"
                   for="restore-backup-file">
                恢复备份
            </label>
            <InputFile @key="restoreFileInputKey"
                       id="restore-backup-file"
                       class="visually-hidden-file"
                       accept=".json,application/json"
                       disabled="@(isExportingBackup || isRestoringBackup)"
                       OnChange="SelectRestoreFileAsync" />
            @if (safetySnapshot is not null)
            {
                <button type="button"
                        disabled="@(isExportingBackup || isRestoringBackup)"
                        @onclick="() => isUndoConfirmationVisible = true">
                    撤销最近恢复
                </button>
            }
        </div>

        @if (isUndoConfirmationVisible && safetySnapshot is not null)
        {
            <section class="restore-confirmation" aria-labelledby="undo-confirmation-heading">
                <h3 id="undo-confirmation-heading">确认撤销最近恢复</h3>
                <p class="settings-status failure" role="alert">
                    这会把当前日历和同步队列替换为
                    @safetySnapshot.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                    保存的状态。恢复完成后新增或修改的数据将被替换。
                </p>
                <div class="settings-actions">
                    <button type="button"
                            class="danger-button"
                            disabled="@isRestoringBackup"
                            @onclick="UndoLastRestoreAsync">
                        @(isRestoringBackup ? "正在撤销…" : "确认撤销")
                    </button>
                    <button type="button"
                            disabled="@isRestoringBackup"
                            @onclick="() => isUndoConfirmationVisible = false">
                        取消
                    </button>
                </div>
            </section>
        }

        @if (isSyncBlockedAfterRestore)
        {
            <section class="restore-confirmation" aria-labelledby="sync-protection-heading">
                <h3 id="sync-protection-heading">恢复后同步保护已启用</h3>
                <p>
                    OneDrive 和 WebDAV 的 Push/Pull 均已暂停，其他标签页也不能绕过此保护。
                    检查恢复结果后，再明确允许下一次手动同步；远端内容届时仍可能按现有冲突规则合并回来。
                </p>
                <button type="button"
                        disabled="@isRestoringBackup"
                        @onclick="AllowSyncAfterRestoreAsync">
                    我已检查，允许手动同步
                </button>
            </section>
        }

        @if (safetySnapshot is not null)
        {
            <p class="settings-note">
                本地保留了 @safetySnapshot.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                的恢复前快照（@safetySnapshot.EventCount 个事件，@safetySnapshot.SyncOperationCount 个同步操作）。
                该快照不会上传，并会在下一次恢复时被替换。
            </p>
        }

        @if (restorePreview is not null)
        {
            <section class="restore-confirmation" aria-labelledby="restore-confirmation-heading">
                <h3 id="restore-confirmation-heading">确认恢复备份</h3>
                <dl class="account-information">
                    <dt>备份日期</dt>
                    <dd>@restorePreview.ExportedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                    <dt>Schema 版本</dt>
                    <dd>@restorePreview.SchemaVersion</dd>
                    <dt>事件数量</dt>
                    <dd>@restorePreview.EventCount</dd>
                </dl>
                <p class="settings-status failure" role="alert">
                    确认后将用该备份替换全部本地日历数据。恢复事务会先在 IndexedDB 中保存可撤销的本地安全快照，
                    并额外下载 JSON 副本。现有同步操作队列将被清空，恢复不会生成新操作；同步将保持暂停，直到你明确解除保护。
                </p>
                <div class="settings-actions">
                    <button type="button"
                            class="danger-button"
                            disabled="@isRestoringBackup"
                            @onclick="ConfirmRestoreAsync">
                        @(isRestoringBackup ? "正在恢复…" : "确认替换本地数据")
                    </button>
                    <button type="button" disabled="@isRestoringBackup" @onclick="CancelRestore">
                        取消
                    </button>
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(backupMessage))
        {
            <p class="settings-status @(backupSucceeded ? "success" : "failure")" role="status">
                @backupMessage
            </p>
        }
    </section>

    <section class="settings-card" aria-labelledby="calendar-transfer-heading">
        <h2 id="calendar-transfer-heading">导入 / 导出</h2>
        <p>导出或预览通用 iCalendar（.ics）文件。选择文件和预览不会修改本地日历。</p>
        <div class="settings-actions">
            <button type="button"
                    class="primary-button"
                    disabled="@(isExportingICalendar || isImportingICalendar)"
                    @onclick="ExportICalendarAsync">
                @(isExportingICalendar ? "正在导出…" : "导出日历（.ics）")
            </button>
            <label class="file-button @(isExportingICalendar || isImportingICalendar ? "disabled" : null)"
                   for="import-calendar-file">
                导入日历（.ics）
            </label>
            <InputFile @key="calendarImportFileInputKey"
                       id="import-calendar-file"
                       class="visually-hidden-file"
                       accept=".ics,text/calendar"
                       disabled="@(isExportingICalendar || isImportingICalendar)"
                       OnChange="SelectCalendarImportFileAsync" />
        </div>

        @if (calendarImportPreview is not null)
        {
            <section class="calendar-import-preview" aria-labelledby="calendar-import-preview-heading">
                <h3 id="calendar-import-preview-heading">导入预览</h3>
                <dl class="account-information">
                    <dt>文件</dt>
                    <dd>@(calendarImportPreview.SourceName ?? "未命名")</dd>
                    <dt>事件总数</dt>
                    <dd>@calendarImportPreview.TotalEventCount</dd>
                    <dt>有效事件</dt>
                    <dd>@calendarImportPreview.ValidEventCount</dd>
                    <dt>警告</dt>
                    <dd>@calendarImportPreview.WarningCount</dd>
                    <dt>无效事件</dt>
                    <dd>@calendarImportPreview.ErrorCount</dd>
                    <dt>可能重复</dt>
                    <dd>@calendarImportPreview.PotentialDuplicateCount</dd>
                </dl>

                @if (calendarImportPreview.Messages.Count > 0)
                {
                    <ul class="calendar-import-messages">
                        @foreach (var message in calendarImportPreview.Messages.Take(MaximumDisplayedImportMessages))
                        {
                            <li class="@(message.Severity == ICalendarImportMessageSeverity.Error ? "failure" : null)">
                                @message.Message
                            </li>
                        }
                    </ul>
                    @if (calendarImportPreview.Messages.Count > MaximumDisplayedImportMessages)
                    {
                        <p class="settings-note">另有 @(calendarImportPreview.Messages.Count - MaximumDisplayedImportMessages) 条信息未显示。</p>
                    }
                }

                <ul class="calendar-import-events">
                    @foreach (var item in calendarImportPreview.Items.Take(MaximumDisplayedImportEvents))
                    {
                        <li>
                            <div>
                                <strong>@item.Candidate.Title</strong>
                                <span>@FormatImportTime(item.Candidate)</span>
                            </div>
                            @if (item.IsPotentialDuplicate)
                            {
                                <label>
                                    相同 UID 已存在：
                                    <select value="@duplicateActions[item.ItemNumber]"
                                            @onchange="args => SetDuplicateAction(item.ItemNumber, args.Value?.ToString())">
                                        <option value="@CalendarImportDuplicateAction.Skip">跳过</option>
                                        <option value="@CalendarImportDuplicateAction.Update">更新现有事件</option>
                                    </select>
                                </label>
                            }
                            else
                            {
                                <span class="settings-note compact">将创建为新事件</span>
                            }
                        </li>
                    }
                </ul>
                @if (calendarImportPreview.Items.Count > MaximumDisplayedImportEvents)
                {
                    <p class="settings-note">预览仅显示前 @MaximumDisplayedImportEvents 个有效事件，确认时会处理全部有效事件。</p>
                }

                <p class="settings-status failure" role="alert">
                    只有确认后才会写入本地日历。每个已创建或更新的事件都会生成一个待处理同步操作，
                    但不会自动开始 OneDrive 或 WebDAV 同步。
                </p>
                <div class="settings-actions">
                    <button type="button"
                            class="primary-button"
                            disabled="@isImportingICalendar"
                            @onclick="ConfirmCalendarImportAsync">
                        @(isImportingICalendar ? "正在导入…" : "确认导入")
                    </button>
                    <button type="button" disabled="@isImportingICalendar" @onclick="CancelCalendarImport">
                        取消
                    </button>
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(calendarTransferMessage))
        {
            <p class="settings-status @(calendarTransferSucceeded ? "success" : "failure")" role="status">
                @calendarTransferMessage
            </p>
        }
    </section>
</main>

@code {
    private SyncProviderType selectedProvider;
    private bool isAuthenticated;
    private bool isTestingConnection;
    private bool connectionSucceeded;
    private string accountDisplayName = "Microsoft 账户";
    private string? accountIdentifier;
    private string? connectionMessage;
    private string? providerStatusMessage;
    private bool isExportingBackup;
    private bool backupSucceeded;
    private string? backupMessage;
    private BackupRestorePreview? restorePreview;
    private bool isRestoringBackup;
    private bool isSyncBlockedAfterRestore;
    private BackupRestoreSafetySnapshot? safetySnapshot;
    private bool isUndoConfirmationVisible;
    private Guid restoreFileInputKey = Guid.NewGuid();
    private const long MaximumBackupFileSize = 20 * 1024 * 1024;
    private bool isExportingICalendar;
    private bool calendarTransferSucceeded;
    private string? calendarTransferMessage;
    private CalendarImportPreview? calendarImportPreview;
    private readonly Dictionary<int, CalendarImportDuplicateAction> duplicateActions = [];
    private bool isImportingICalendar;
    private Guid calendarImportFileInputKey = Guid.NewGuid();
    private const long MaximumCalendarImportFileSize = 10 * 1024 * 1024;
    private const int MaximumDisplayedImportEvents = 100;
    private const int MaximumDisplayedImportMessages = 50;

    private bool isAuthenticationConfigured =>
        !string.IsNullOrWhiteSpace(AppConfiguration.MicrosoftAuthentication.ClientId);

    protected override async Task OnInitializedAsync()
    {
        var configuration = await ProviderSelection.GetAsync();
        selectedProvider = configuration.ProviderType;

        try
        {
            isSyncBlockedAfterRestore = await LocalBackupRestoreService.IsSyncBlockedAfterRestoreAsync();
            safetySnapshot = await LocalBackupRestoreService.GetSafetySnapshotAsync();
            isUndoConfirmationVisible = false;
        }
        catch (Exception exception) when (
            exception is LocalBackupRestoreException or BackupRestoreRepositoryException or SyncOperationException)
        {
            backupSucceeded = false;
            backupMessage = "无法读取恢复安全状态。请重新载入页面后再试。";
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            accountDisplayName = FirstClaimValue(user, "name")
                ?? user.Identity?.Name
                ?? "Microsoft 账户";
            accountIdentifier = FirstClaimValue(user, "preferred_username")
                ?? FirstClaimValue(user, ClaimTypes.Email)
                ?? FirstClaimValue(user, "emails");
        }
    }

    private async Task SelectProviderAsync(SyncProviderType providerType)
    {
        await ProviderSelection.SelectAsync(providerType);
        selectedProvider = providerType;
        providerStatusMessage = providerType switch
        {
            SyncProviderType.None => "已选择不使用同步。",
            SyncProviderType.OneDrive => "已选择 OneDrive。连接成功后可在日历首页同步。",
            SyncProviderType.WebDav => "已选择 WebDAV；请先完成 WebDAV 连接配置。",
            _ => null
        };
    }

    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    private void Disconnect() => Navigation.NavigateToLogout(
        "authentication/logout",
        Navigation.ToAbsoluteUri("settings").AbsoluteUri);

    private async Task TestConnectionAsync()
    {
        isTestingConnection = true;
        connectionMessage = null;

        try
        {
            var result = await OneDriveConnectionTester.TestAsync();
            connectionSucceeded = result.IsSuccess;
            connectionMessage = result.Message;
        }
        finally
        {
            isTestingConnection = false;
        }
    }

    private async Task ExportBackupAsync()
    {
        isExportingBackup = true;
        backupMessage = null;

        try
        {
            var export = await LocalBackupService.CreateExportAsync();
            await BrowserFileDownloadService.DownloadJsonAsync(export.FileName, export.Json);
            backupSucceeded = true;
            backupMessage = $"备份已生成：{export.FileName}";
        }
        catch (Exception exception) when (
            exception is LocalBackupException or LocalBackupDownloadException or EventRepositoryException)
        {
            backupSucceeded = false;
            backupMessage = exception.Message;
        }
        finally
        {
            isExportingBackup = false;
        }
    }

    private async Task ExportICalendarAsync()
    {
        isExportingICalendar = true;
        calendarTransferMessage = null;
        try
        {
            var export = await ICalendarExportService.CreateExportAsync();
            await BrowserFileDownloadService.DownloadICalendarAsync(export.FileName, export.Content);
            calendarTransferSucceeded = true;
            calendarTransferMessage = $"日历已导出：{export.FileName}";
        }
        catch (Exception exception) when (
            exception is ICalendarExportException or ICalendarDownloadException or
                EventRepositoryException or RecurrenceRuleException)
        {
            calendarTransferSucceeded = false;
            calendarTransferMessage = exception.Message;
        }
        finally
        {
            isExportingICalendar = false;
        }
    }

    private async Task SelectCalendarImportFileAsync(InputFileChangeEventArgs args)
    {
        if (calendarImportPreview is not null)
        {
            ICalendarImportService.Cancel(calendarImportPreview.ImportId);
            calendarImportPreview = null;
        }

        duplicateActions.Clear();
        calendarTransferMessage = null;
        try
        {
            var file = args.File;
            if (file.Size > MaximumCalendarImportFileSize)
            {
                throw new ICalendarImportException("iCalendar 文件超过 10 MB，未读取或修改本地数据。");
            }

            await using var stream = file.OpenReadStream(MaximumCalendarImportFileSize);
            using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
            var content = await reader.ReadToEndAsync();
            calendarImportPreview = await ICalendarImportService.PrepareAsync(content, file.Name);
            foreach (var item in calendarImportPreview.Items.Where(item => item.IsPotentialDuplicate))
            {
                duplicateActions[item.ItemNumber] = CalendarImportDuplicateAction.Skip;
            }

            calendarTransferSucceeded = true;
            calendarTransferMessage = "文件解析完成。请检查预览和重复项处理方式，再确认导入。";
        }
        catch (Exception exception) when (
            exception is ICalendarImportException or CalendarImportException or
                EventRepositoryException or IOException or InvalidOperationException)
        {
            calendarTransferSucceeded = false;
            calendarTransferMessage = exception is IOException or InvalidOperationException
                ? "无法读取 iCalendar 文件，本地数据没有改变。"
                : exception.Message;
        }
    }

    private async Task ConfirmCalendarImportAsync()
    {
        if (calendarImportPreview is null)
        {
            return;
        }

        isImportingICalendar = true;
        calendarTransferMessage = null;
        try
        {
            var result = await ICalendarImportService.ConfirmAsync(
                calendarImportPreview.ImportId,
                duplicateActions);
            calendarImportPreview = null;
            duplicateActions.Clear();
            calendarImportFileInputKey = Guid.NewGuid();
            calendarTransferSucceeded = true;
            calendarTransferMessage =
                $"导入完成：新建 {result.CreatedCount} 个，更新 {result.UpdatedCount} 个，跳过 {result.SkippedCount} 个。" +
                "已生成待处理同步操作，但尚未自动同步到远端。";
        }
        catch (Exception exception) when (
            exception is CalendarImportException or SyncOperationException or EventRepositoryException)
        {
            calendarTransferSucceeded = false;
            calendarTransferMessage = exception.Message;
        }
        finally
        {
            isImportingICalendar = false;
        }
    }

    private void CancelCalendarImport()
    {
        if (calendarImportPreview is not null)
        {
            ICalendarImportService.Cancel(calendarImportPreview.ImportId);
            calendarImportPreview = null;
        }

        duplicateActions.Clear();
        calendarImportFileInputKey = Guid.NewGuid();
        calendarTransferSucceeded = true;
        calendarTransferMessage = "已取消导入，本地数据没有改变。";
    }

    private void SetDuplicateAction(int itemNumber, string? value)
    {
        duplicateActions[itemNumber] = Enum.TryParse<CalendarImportDuplicateAction>(value, out var action)
            ? action
            : CalendarImportDuplicateAction.Skip;
    }

    private static string FormatImportTime(ICalendarImportCandidate candidate) =>
        candidate.IsAllDay
            ? $"全天 · {candidate.StartUtc:yyyy-MM-dd} 至 {candidate.EndUtc.AddDays(-1):yyyy-MM-dd}"
            : $"{candidate.StartUtc.ToLocalTime():yyyy-MM-dd HH:mm} – {candidate.EndUtc.ToLocalTime():yyyy-MM-dd HH:mm}";

    private async Task SelectRestoreFileAsync(InputFileChangeEventArgs args)
    {
        if (restorePreview is not null)
        {
            LocalBackupRestoreService.CancelPreparedRestore(restorePreview.RestoreId);
            restorePreview = null;
        }

        backupMessage = null;
        try
        {
            var file = args.File;
            if (file.Size > MaximumBackupFileSize)
            {
                throw new LocalBackupRestoreException("备份文件超过 20 MB 限制，未读取或修改本地数据。");
            }

            await using var stream = file.OpenReadStream(MaximumBackupFileSize);
            using var reader = new StreamReader(stream, detectEncodingFromByteOrderMarks: true);
            var json = await reader.ReadToEndAsync();
            restorePreview = LocalBackupRestoreService.PrepareRestore(json);
            backupSucceeded = true;
            backupMessage = "备份验证通过。请检查摘要并确认是否替换本地数据。";
        }
        catch (Exception exception) when (
            exception is LocalBackupRestoreException or IOException or InvalidOperationException)
        {
            backupSucceeded = false;
            backupMessage = exception is LocalBackupRestoreException
                ? exception.Message
                : "无法读取备份文件，未修改本地数据。";
        }
    }

    private async Task ConfirmRestoreAsync()
    {
        if (restorePreview is null)
        {
            return;
        }

        isRestoringBackup = true;
        backupMessage = null;
        try
        {
            var syncStatus = await SyncDiagnosticsService.GetStatusAsync();
            if (syncStatus.IsSyncing)
            {
                throw new LocalBackupRestoreException("同步正在进行，请等待同步结束后再恢复备份。未修改本地数据。");
            }

            var safetyExport = await LocalBackupService.CreateExportAsync();
            var safetyFileName = $"mycalendar-safety-before-restore-{DateTimeOffset.UtcNow:yyyy-MM-dd-HHmmss}.json";
            await BrowserFileDownloadService.DownloadJsonAsync(
                safetyFileName,
                safetyExport.Json);

            var result = await LocalBackupRestoreService.RestorePreparedAsync(restorePreview.RestoreId);
            restorePreview = null;
            restoreFileInputKey = Guid.NewGuid();
            isSyncBlockedAfterRestore = true;
            safetySnapshot = await LocalBackupRestoreService.GetSafetySnapshotAsync();
            isUndoConfirmationVisible = false;
            backupSucceeded = true;
            backupMessage = $"已恢复 {result.EventCount} 个事件并清空旧同步队列。本地安全快照已保存并下载；同步保护已启用，远端数据没有被自动读取或覆盖。";
        }
        catch (Exception exception) when (
            exception is LocalBackupException or LocalBackupDownloadException or
                LocalBackupRestoreException or EventRepositoryException or SyncOperationException)
        {
            backupSucceeded = false;
            backupMessage = exception.Message;
        }
        finally
        {
            isRestoringBackup = false;
        }
    }

    private async Task UndoLastRestoreAsync()
    {
        isRestoringBackup = true;
        backupMessage = null;
        try
        {
            var result = await LocalBackupRestoreService.UndoLastRestoreAsync();
            safetySnapshot = null;
            isUndoConfirmationVisible = false;
            isSyncBlockedAfterRestore = await LocalBackupRestoreService.IsSyncBlockedAfterRestoreAsync();
            backupSucceeded = true;
            backupMessage = $"已撤销最近一次恢复，恢复了 {result.EventCount} 个事件以及原同步队列。";
        }
        catch (LocalBackupRestoreException exception)
        {
            backupSucceeded = false;
            backupMessage = exception.Message;
        }
        finally
        {
            isRestoringBackup = false;
        }
    }

    private async Task AllowSyncAfterRestoreAsync()
    {
        try
        {
            await LocalBackupRestoreService.AllowSyncAfterRestoreAsync();
            isSyncBlockedAfterRestore = false;
            backupSucceeded = true;
            backupMessage = "同步保护已解除。同步仍不会自动开始；只有点击“立即同步”或“重试失败项”才会访问远端。";
        }
        catch (SyncOperationException)
        {
            backupSucceeded = false;
            backupMessage = "无法解除同步保护，请重新载入页面后再试。";
        }
    }

    private void CancelRestore()
    {
        if (restorePreview is not null)
        {
            LocalBackupRestoreService.CancelPreparedRestore(restorePreview.RestoreId);
            restorePreview = null;
        }

        restoreFileInputKey = Guid.NewGuid();

        backupSucceeded = true;
        backupMessage = "已取消恢复，本地数据没有改变。";
    }

    private static string? FirstClaimValue(ClaimsPrincipal user, string claimType) =>
        user.Claims.FirstOrDefault(claim => claim.Type == claimType)?.Value;
}
