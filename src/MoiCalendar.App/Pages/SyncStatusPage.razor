@page "/sync-status"
@using MoiCalendar.App.Components
@using MoiCalendar.Core
@using MoiCalendar.Sync
@using MoiCalendar.Sync.Cloud
@using MoiCalendar.Sync.Diagnostics
@inject ICloudSyncStatusService SyncStatusService
@inject ISyncDiagnosticsService BackupSyncDiagnostics
@inject IDiagnosticReportService DiagnosticReportService
@inject IBrowserFileDownloadService BrowserFileDownloadService

<PageTitle>同步状态 | MoiCalendar</PageTitle>

<main class="settings-shell">
    <header class="settings-page-header">
        <div>
            <span class="v4-meta">SYNC / STATUS</span>
            <h1>同步状态</h1>
        </div>
        <a href="">返回日历</a>
    </header>
    <p class="settings-note">本地日历始终可用。这里只显示需要你关注的同步状态；实现细节位于诊断区域。</p>

    <section class="settings-card sync-status-card" aria-labelledby="last-sync-heading">
        <div class="settings-heading-row">
            <h2 id="last-sync-heading">上次同步</h2>
            <a href="settings#sync-settings">管理同步</a>
        </div>
        @if (status is not null)
        {
            <p class="sync-summary-state"><SyncIndicator State="status.State" LastSuccessfulSyncAtUtc="status.LastSuccessfulSyncAtUtc" /> @FormatState(status.State)</p>
            <dl class="account-information sync-facts">
                <dt>上次成功同步</dt>
                <dd>@FormatTimestamp(status.LastSuccessfulSyncAtUtc)</dd>
                @if (backupStatus is not null && backupStatus.ActiveProvider != "None")
                {
                    <dt>@FormatProvider(backupStatus.ActiveProvider) 上次成功备份</dt>
                    <dd>@FormatTimestamp(backupStatus.LastSuccessfulSyncAtUtc)</dd>
                }
            </dl>
            <p>@DescribeState(status.State)</p>
        }
        else
        {
            <p class="settings-note">正在读取同步状态…</p>
        }
        <button type="button" disabled="@isBusy" @onclick="RefreshAsync">刷新状态</button>
    </section>

    <div id="diagnostics-heading" tabindex="-1">
        @if (diagnosticReport is not null)
        {
            <section class="settings-card" aria-labelledby="diagnostics-title">
            <h2 id="diagnostics-title">运行诊断</h2>
            <p>
                诊断只保存在此浏览器，不会自动上传。它只包含运行状态、计数、耗时和安全错误类别，不包含日历标题、说明、地点或登录凭据。
            </p>
            <dl class="account-information sync-facts">
                <dt>应用版本</dt>
                <dd>@diagnosticReport.Health.ApplicationVersion</dd>
                <dt>客户端平台</dt>
                <dd>@diagnosticReport.Health.ClientPlatform</dd>
                <dt>IndexedDB</dt>
                <dd>@FormatLocalStorageState(diagnosticReport.Health.LocalIndexedDbState)</dd>
                <dt>云后端配置</dt>
                <dd>@(diagnosticReport.Health.CloudBackendConfigured ? "已配置" : "未配置（仅本地）")</dd>
                <dt>认证状态</dt>
                <dd>@FormatAuthenticationState(diagnosticReport.Health.AuthenticationState)</dd>
                <dt>上次成功同步</dt>
                <dd>@FormatTimestamp(diagnosticReport.Health.LastSuccessfulSyncAtUtc)</dd>
                <dt>待处理 Outbox</dt>
                <dd>@(diagnosticReport.Health.PendingOutboxCount?.ToString() ?? "暂时无法读取")</dd>
                <dt>同步状态</dt>
                <dd>@FormatDiagnosticSyncState(diagnosticReport.Health.CurrentSyncState)</dd>
                <dt>Realtime</dt>
                <dd>@FormatRealtimeState(diagnosticReport.Health.RealtimeState)</dd>
                <dt>本地运行事件</dt>
                <dd>@(diagnosticReport.OperationalEventCollectionEnabled ? $"{diagnosticReport.OperationalEvents.Count} 条" : "已关闭")</dd>
            </dl>
            <div class="settings-actions">
                <button type="button" disabled="@isDiagnosticBusy" @onclick="ExportDiagnosticsAsync">
                    @(isDiagnosticBusy ? "正在生成…" : "导出支持诊断")
                </button>
                <button type="button" disabled="@isDiagnosticBusy" @onclick="LoadDiagnosticsAsync">刷新诊断</button>
                @if (diagnosticReport.OperationalEventCollectionEnabled)
                {
                    <button type="button" class="danger-button" disabled="@isDiagnosticBusy" @onclick="ClearDiagnosticsAsync">
                        清除本地诊断事件
                    </button>
                }
            </div>

            @if (!diagnosticReport.OperationalEventCollectionEnabled)
            {
                <p class="settings-note">运行事件收集已通过配置关闭；按需生成的健康摘要仍可导出。</p>
            }
            else if (diagnosticReport.OperationalEvents.Count > 0)
            {
                <details class="diagnostic-event-details">
                    <summary>查看最近的结构化事件</summary>
                    <ol class="sync-log-list">
                        @foreach (var entry in diagnosticReport.OperationalEvents.Take(20))
                        {
                            <li>
                                <div>
                                    <strong>@FormatDiagnosticKind(entry.Kind)</strong>
                                    <time datetime="@entry.TimestampUtc.ToString("O")">@FormatTimestamp(entry.TimestampUtc)</time>
                                </div>
                                <div>@FormatDiagnosticOutcome(entry.Outcome) · @FormatFailureCategory(entry.FailureCategory)</div>
                                @if (entry.DurationMilliseconds is not null)
                                {
                                    <div>耗时：@entry.DurationMilliseconds ms</div>
                                }
                                @if (entry.PushedCount is not null || entry.PulledCount is not null || entry.ConflictCount is not null)
                                {
                                    <div>上传 @(entry.PushedCount ?? 0) · 接收 @(entry.PulledCount ?? 0) · 冲突 @(entry.ConflictCount ?? 0)</div>
                                }
                                @if (entry.RetryCount is not null)
                                {
                                    <div>此前重试：@entry.RetryCount 次</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.ErrorCode))
                                {
                                    <div>安全错误代码：@entry.ErrorCode</div>
                                }
                            </li>
                        }
                    </ol>
                </details>
            }
            </section>
        }
    </div>

    <section class="settings-card" aria-labelledby="backup-log-heading">
            <h2 id="backup-log-heading" tabindex="-1">备份同步日志</h2>
            <div class="settings-actions"><button class="danger-button" type="button" disabled="@isBusy" @onclick="ClearBackupLogAsync">清除日志</button></div>
            @if (backupLogEntries.Count == 0)
            {
                <p class="settings-note">暂无同步日志。</p>
            }
            else
            {
                <ol class="sync-log-list">
                    @foreach (var entry in backupLogEntries)
                    {
                        <li>
                            <div>
                                <strong>@FormatSeverity(entry.Severity)</strong>
                                <time datetime="@entry.TimestampUtc.ToString("O")">@FormatTimestamp(entry.TimestampUtc)</time>
                            </div>
                            <div>@FormatStage(entry.Stage) · @FormatProvider(entry.Provider)</div>
                            <p>@entry.Message</p>
                            @if (!string.IsNullOrWhiteSpace(entry.ErrorCode))
                            {
                                <div>错误代码：@entry.ErrorCode</div>
                            }
                        </li>
                    }
                </ol>
            }
    </section>
    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <p class="settings-status @(actionSucceeded ? "success" : "failure")" role="status">@actionMessage</p>
    }
</main>
<SectionNavigation Ready="@(!isBusy)" />

@code {
    private CloudSyncSnapshot? status;
    private SyncStatus? backupStatus;
    private IReadOnlyList<SyncLogEntry> backupLogEntries = [];
    private DiagnosticReport? diagnosticReport;
    private bool isBusy;
    private bool isDiagnosticBusy;
    private bool actionSucceeded;
    private string? actionMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task RefreshAsync()
    {
        if (!isBusy) await LoadAsync();
    }

    private async Task ClearBackupLogAsync()
    {
        await BackupSyncDiagnostics.ClearLogAsync();
        backupLogEntries = [];
        actionSucceeded = true;
        actionMessage = "备份同步日志已清除。";
    }

    private async Task LoadBackupLogAsync() =>
        backupLogEntries = await BackupSyncDiagnostics.GetLogEntriesAsync();

    private async Task LoadAsync()
    {
        isBusy = true;
        try
        {
            status = await SyncStatusService.GetStatusAsync();
            await LoadBackupLogAsync();
            backupStatus = await BackupSyncDiagnostics.GetStatusAsync();
            diagnosticReport = await DiagnosticReportService.GetReportAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch
        {
            actionSucceeded = false;
            actionMessage = "同步状态暂时无法读取，本地日历仍可正常使用。";
        }
        finally { isBusy = false; }
    }

    private async Task LoadDiagnosticsAsync()
    {
        if (isDiagnosticBusy)
        {
            return;
        }

        isDiagnosticBusy = true;
        try
        {
            diagnosticReport = await DiagnosticReportService.GetReportAsync();
            actionSucceeded = true;
            actionMessage = "诊断摘要已刷新。";
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            actionSucceeded = false;
            actionMessage = "暂时无法读取本地诊断；日历功能不受影响。";
        }
        finally
        {
            isDiagnosticBusy = false;
        }
    }

    private async Task ExportDiagnosticsAsync()
    {
        if (isDiagnosticBusy)
        {
            return;
        }

        isDiagnosticBusy = true;
        try
        {
            var export = await DiagnosticReportService.CreateExportAsync();
            await BrowserFileDownloadService.DownloadJsonAsync(export.FileName, export.Json);
            diagnosticReport = await DiagnosticReportService.GetReportAsync();
            actionSucceeded = true;
            actionMessage = $"支持诊断已导出，共 {export.EventCount} 条结构化运行事件。请在发送前自行检查文件内容。";
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            actionSucceeded = false;
            actionMessage = "诊断文件未能下载；日历和同步数据没有改变。";
        }
        finally
        {
            isDiagnosticBusy = false;
        }
    }

    private async Task ClearDiagnosticsAsync()
    {
        if (isDiagnosticBusy)
        {
            return;
        }

        isDiagnosticBusy = true;
        try
        {
            await DiagnosticReportService.ClearEventsAsync();
            diagnosticReport = await DiagnosticReportService.GetReportAsync();
            actionSucceeded = true;
            actionMessage = "此浏览器中的运行诊断事件已清除。";
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            actionSucceeded = false;
            actionMessage = "未能清除本地诊断事件；日历数据没有改变。";
        }
        finally
        {
            isDiagnosticBusy = false;
        }
    }

    private static string FormatState(CloudSyncDisplayState state) => state switch
    {
        CloudSyncDisplayState.LocalOnly => "仅本地", CloudSyncDisplayState.SignedOut => "未登录",
        CloudSyncDisplayState.Synced => "已同步", CloudSyncDisplayState.Syncing => "正在同步",
        CloudSyncDisplayState.Offline => "离线", CloudSyncDisplayState.PendingChanges => "有待同步变更",
        CloudSyncDisplayState.RetryScheduled => "等待重试", CloudSyncDisplayState.AuthenticationRequired => "需要重新登录",
        CloudSyncDisplayState.Conflict => "存在冲突", CloudSyncDisplayState.Error => "同步错误", _ => "未知"
    };

    private static string DescribeState(CloudSyncDisplayState state) => state switch
    {
        CloudSyncDisplayState.LocalOnly => "云同步未启用；所有日历功能仍在本机可用。",
        CloudSyncDisplayState.SignedOut => "登录云账户后才能使用增量云同步。",
        CloudSyncDisplayState.Synced => "没有待处理的本地变更或冲突。",
        CloudSyncDisplayState.Syncing => "正在通过可靠的 Push/Pull 协议同步。",
        CloudSyncDisplayState.Offline => "网络暂时不可用，本地修改已保留。",
        CloudSyncDisplayState.PendingChanges => "本地修改已经保存，等待上传。",
        CloudSyncDisplayState.RetryScheduled => "上次网络操作未完成，系统会安全重试。",
        CloudSyncDisplayState.AuthenticationRequired => "云账户会话已失效，请重新登录。",
        CloudSyncDisplayState.Conflict => "至少一个日程需要你选择保留哪个版本。",
        CloudSyncDisplayState.Error => "同步未完成，但本地修改没有丢失。", _ => string.Empty
    };

    private static string FormatRealtimeState(RealtimeConnectionState state) => state switch
    {
        RealtimeConnectionState.Disabled => "未启用", RealtimeConnectionState.Disconnected => "未连接",
        RealtimeConnectionState.Connecting => "正在连接", RealtimeConnectionState.Connected => "已连接（仅用于唤醒）",
        RealtimeConnectionState.Reconnecting => "正在重新连接", RealtimeConnectionState.Unavailable => "不可用", _ => "未知"
    };

    private static string FormatLocalStorageState(DiagnosticLocalStorageState state) => state switch
    {
        DiagnosticLocalStorageState.Available => "可用",
        _ => "不可用"
    };

    private static string FormatAuthenticationState(DiagnosticAuthenticationState state) => state switch
    {
        DiagnosticAuthenticationState.Disabled => "未启用",
        DiagnosticAuthenticationState.SignedOut => "未登录",
        DiagnosticAuthenticationState.SignedIn => "已登录",
        _ => "暂时无法验证"
    };

    private static string FormatDiagnosticSyncState(DiagnosticSyncState state) => state switch
    {
        DiagnosticSyncState.LocalOnly => "仅本地",
        DiagnosticSyncState.SignedOut => "未登录",
        DiagnosticSyncState.Synced => "已同步",
        DiagnosticSyncState.Syncing => "正在同步",
        DiagnosticSyncState.Offline => "离线",
        DiagnosticSyncState.PendingChanges => "有待处理变更",
        DiagnosticSyncState.RetryScheduled => "等待重试",
        DiagnosticSyncState.AuthenticationRequired => "需要重新登录",
        DiagnosticSyncState.Conflict => "存在冲突",
        DiagnosticSyncState.Error => "错误",
        _ => "暂时无法读取"
    };

    private static string FormatDiagnosticKind(OperationalDiagnosticKind kind) => kind switch
    {
        OperationalDiagnosticKind.SyncStarted => "同步开始",
        OperationalDiagnosticKind.SyncCompleted => "同步完成",
        OperationalDiagnosticKind.PushFailure => "上传失败",
        OperationalDiagnosticKind.PullFailure => "下载失败",
        OperationalDiagnosticKind.RealtimeConnectionFailure => "Realtime 连接失败",
        OperationalDiagnosticKind.AuthenticationRefreshFailure => "认证刷新失败",
        OperationalDiagnosticKind.CloudEndpointAvailabilityFailure => "云端可用性失败",
        _ => "运行事件"
    };

    private static string FormatDiagnosticOutcome(OperationalDiagnosticOutcome outcome) => outcome switch
    {
        OperationalDiagnosticOutcome.Started => "开始",
        OperationalDiagnosticOutcome.Succeeded => "成功",
        OperationalDiagnosticOutcome.Offline => "离线",
        OperationalDiagnosticOutcome.Conflict => "冲突",
        OperationalDiagnosticOutcome.RetryScheduled => "已安排重试",
        OperationalDiagnosticOutcome.AuthenticationRequired => "需要认证",
        OperationalDiagnosticOutcome.Unavailable => "不可用",
        OperationalDiagnosticOutcome.Cancelled => "已取消",
        _ => "失败"
    };

    private static string FormatFailureCategory(OperationalFailureCategory category) => category switch
    {
        OperationalFailureCategory.None => "无错误",
        OperationalFailureCategory.Network => "网络",
        OperationalFailureCategory.Authentication => "认证",
        OperationalFailureCategory.Conflict => "冲突",
        OperationalFailureCategory.RateLimited => "频率限制",
        OperationalFailureCategory.Server => "服务端",
        OperationalFailureCategory.LocalStorage => "本地存储",
        OperationalFailureCategory.Configuration => "配置",
        OperationalFailureCategory.InvalidData => "数据格式",
        _ => "未知"
    };

    private static string FormatTimestamp(DateTimeOffset? timestamp) =>
        timestamp?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "从未";

    private static string FormatProvider(string provider) => provider switch
    {
        "None" => "无", "OneDrive" => "OneDrive", "WebDav" => "WebDAV", _ => provider
    };

    private static string FormatSeverity(SyncLogSeverity severity) => severity switch
    {
        SyncLogSeverity.Information => "信息", SyncLogSeverity.Warning => "警告",
        SyncLogSeverity.Error => "错误", _ => severity.ToString()
    };

    private static string FormatStage(SyncLogStage stage) => stage switch
    {
        SyncLogStage.Synchronize => "同步", SyncLogStage.Push => "上传",
        SyncLogStage.Pull => "下载", SyncLogStage.Retry => "重试", _ => stage.ToString()
    };
}
